            "mimeType": "application/json; charset=UTF-8",
            "text": "{\"id\":\"876f63f4-4bef-4399-9edc-ab3e51c94bc5\",\"content\":{\"question\":\"1. صمم واكتب كود بايثون متكامل بنظام Asyncio لتطبيق معمارية Circuit Breaker Pattern مع Retry و Expon\",\"type\":\"text\",\"status\":\"processing\",\"source\":\"agent\",\"created_at\":1787625808,\"updated_at\":1787625942,\"chat_list\":[{\"label\":\"1. صمم واكتب كود بايثون متكامل بنظام Asyncio لتطبيق معمارية Circuit Breaker Pattern مع Retry و Exponent\",\"question\":\"1. صمم واكتب كود بايثون متكامل بنظام Asyncio لتطبيق معمارية Circuit Breaker Pattern مع Retry و Exponent\",\"answer\":[\"\"],\"reasoning\":[{\"startedAt\":null,\"endedAt\":null,\"reasoning\":\"\",\"thinkingSeconds\":0}],\"blocks\":[{\"type\":\"text\",\"content\":\"سأصمم لك نظام Circuit Breaker Pattern متكامل مع Retry و Exponential Backoff باستخدام Asyncio. هذا مشروع متوسط التعقيد يستحق التخطيط أولاً.\",\"startedAt\":\"2026-08-25T02:43:40.000Z\",\"endedAt\":\"2026-08-25T02:43:41.000Z\"},{\"type\":\"credit_usage\",\"content\":2,\"startedAt\":\"2026-08-25T02:43:42.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_01a036cd58747ee29eab4c0b\",\"name\":\"write_todos\",\"args\":{\"todos\":[{\"content\":\"تصميم هيكل المشروع والكلاسات الأساسية\",\"status\":\"in_progress\"},{\"content\":\"كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)\",\"status\":\"pending\"},{\"content\":\"إضافة آلية Retry مع Exponential Backoff و Jitter\",\"status\":\"pending\"},{\"content\":\"إنشاء أمثلة عملية واختبارات توضيحية\",\"status\":\"pending\"},{\"content\":\"رفع الملف للمستخدم\",\"status\":\"pending\"}],\"__result\":\"Updated todo list to [{'content': 'تصميم هيكل المشروع والكلاسات الأساسية', 'status': 'in_progress'}, {'content': 'كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)', 'status': 'pending'}, {'content': 'إضافة آلية Retry مع Exponential Backoff و Jitter', 'status': 'pending'}, {'content': 'إنشاء أمثلة عملية واختبارات توضيحية', 'status': 'pending'}, {'content': 'رفع الملف للمستخدم', 'status': 'pending'}]\"},\"result\":\"Updated todo list to [{'content': 'تصميم هيكل المشروع والكلاسات الأساسية', 'status': 'in_progress'}, {'content': 'كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)', 'status': 'pending'}, {'content': 'إضافة آلية Retry مع Exponential Backoff و Jitter', 'status': 'pending'}, {'content': 'إنشاء أمثلة عملية واختبارات توضيحية', 'status': 'pending'}, {'content': 'رفع الملف للمستخدم', 'status': 'pending'}]\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:43:42.000Z\",\"endedAt\":\"2026-08-25T02:43:42.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_01a036cd58747ee29eab4c0b\",\"name\":\"write_todos\",\"content\":\"Updated todo list to [{'content': 'تصميم هيكل المشروع والكلاسات الأساسية', 'status': 'in_progress'}, {'content': 'كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)', 'status': 'pending'}, {'content': 'إضافة آلية Retry مع Exponential Backoff و Jitter', 'status': 'pending'}, {'content': 'إنشاء أمثلة عملية واختبارات توضيحية', 'status': 'pending'}, {'content': 'رفع الملف للمستخدم', 'status': 'pending'}]\"},\"startedAt\":\"2026-08-25T02:43:42.000Z\",\"endedAt\":\"2026-08-25T02:43:42.000Z\"},{\"type\":\"reasoning\",\"content\":\"{\\\"file_path\\\":\\\"/home/daytona/circuit_breaker_asyncio.py\\\",\\\"content\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\nCircuit Breaker Pattern مع Retry و Exponential Backoff\\\\n=====================================================\\\\nنظام متكامل باستخدام Asyncio لحماية الخدمات من الانهيار cascading failures.\\\\n\\\\nالمميزات:\\\\n- Circuit Breaker بثلاث حالات (CLOSED, OPEN, HALF_OPEN)\\\\n- Retry مع Exponential Backoff و Jitter\\\\n- مراقبة وإحصائيات في الوقت الفعلي\\\\n- دعم Async/Await كامل\\\\n- تسجيل مفصل للأحداث\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nfrom __future__ import annotations\\\\n\\\\nimport asyncio\\\\nimport logging\\\\nimport random\\\\nimport time\\\\nfrom dataclasses import dataclass, field\\\\nfrom enum import Enum\\\\nfrom functools import wraps\\\\nfrom typing import Any, Awaitable, Callable, Optional, TypeVar, Union\\\\n\\\\n# إعداد التسجيل\\\\nlogging.basicConfig(\\\\n    level=logging.INFO,\\\\n    format=\\\\\\\"%(asctime)s | %(levelname)-8s | %(name)s | %(message)s\\\\\\\",\\\\n)\\\\nlogger = logging.getLogger(\\\\\\\"CircuitBreaker\\\\\\\")\\\\n\\\\nT = TypeVar(\\\\\\\"T\\\\\\\")\\\\n\\\\n\\\\n# ============================================================\\\\n# 1) تعريف الاستثناءات المخصصة\\\\n# ============================================================\\\\nclass CircuitBreakerError(Exception):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"الاستثناء الأساسي لنظام Circuit Breaker.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n\\\\nclass CircuitOpenError(CircuitBreakerError):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"يُطلق عندما يكون الـ Circuit في حالة OPEN.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(self, breaker_name: str, retry_after: float):\\\\n        self.breaker_name = breaker_name\\\\n        self.retry_after = retry_after\\\\n        super().__init__(\\\\n            f\\\\\\\"Circuit '{breaker_name}' مفتوح. أعد المحاولة بعد {retry_after:.2f} ثانية\\\\\\\"\\\\n        )\\\\n\\\\n\\\\nclass RetryExhaustedError(CircuitBreakerError):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"يُطلق عند استنفاد جميع محاولات الـ Retry.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(self, attempts: int, last_exception: Optional[Exception]):\\\\n        self.attempts = attempts\\\\n        self.last_exception = last_exception\\\\n        msg = f\\\\\\\"فشل بعد {attempts} محاولة\\\\\\\"\\\\n        if last_exception:\\\\n            msg += f\\\\\\\" | آخر خطأ: {type(last_exception).__name__}: {last_exception}\\\\\\\"\\\\n        super().__init__(msg)\\\\n\\\\n\\\\n# ============================================================\\\\n# 2) تعريف حالات الـ Circuit Breaker\\\\n# ============================================================\\\\nclass CircuitState(str, Enum):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"حالات الـ Circuit Breaker الثلاث.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    CLOSED = \\\\\\\"CLOSED\\\\\\\"            # الحالة الطبيعية - الطلبات تمر\\\\n    OPEN = \\\\\\\"OPEN\\\\\\\"                # الحالة المحمية - الطلبات تُرفض فوراً\\\\n    HALF_OPEN = \\\\\\\"HALF_OPEN\\\\\\\"      # حالة الاختبار - عدد محدود من الطلبات\\\\n\\\\n\\\\n# ============================================================\\\\n# 3) إعدادات النظام\\\\n# ============================================================\\\\n@dataclass\\\\nclass CircuitBreakerConfig:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"إعدادات الـ Circuit Breaker.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    # --- إعدادات الفشل والانتقال إلى OPEN ---\\\\n    failure_threshold: int = 5            # عدد مرات الفشل لفتح الـ Circuit\\\\n    failure_rate_threshold: float = 50.0  # نسبة الفشل % لفتح الـ Circuit\\\\n    minimum_calls: int = 10               # الحد الأدنى من الطلبات قبل التقييم\\\\n\\\\n    # --- إعدادات زمن إعادة المحاولة ---\\\\n    recovery_timeout: float = 30.0        # مدة الانتظار قبل HALF_OPEN (ثانية)\\\\n    half_open_max_calls: int = 3          # عدد الطلبات المسموح بها في HALF_OPEN\\\\n\\\\n    # --- إعدادات إضافية ---\\\\n    success_threshold: int = 2            # عدد النجاحات لإغلاق الـ Circuit من HALF_OPEN\\\\n    excluded_exceptions: tuple = ()       # استثناءات لا تُحسب كـ failure\\\\n\\\\n\\\\n@dataclass\\\\nclass RetryConfig:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"إعدادات الـ Retry و Exponential Backoff.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    max_attempts: int = 5\\\\n    initial_delay: float = 1.0            # التأخير الأولي بالثواني\\\\n    max_delay: float = 60.0               # الحد الأقصى للتأخير\\\\n    exponential_base: float = 2.0         # أساس المضاعفة\\\\n    jitter: bool = True                   # إضافة عشوائية لتجنب thundering herd\\\\n    jitter_range: float = 0.1             # نطاق العشوائية (10%)\\\\n    retry_on: tuple = (Exception,)        # الاستثناءات التي تستدعي إعادة المحاولة\\\\n\\\\n\\\\n# ============================================================\\\\n# 4) إحصائيات الـ Circuit Breaker\\\\n# ============================================================\\\\n@dataclass\\\\nclass CircuitStats:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"إحصائيات في الوقت الفعلي للـ Circuit Breaker.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    total_calls: int = 0\\\\n    successful_calls: int = 0\\\\n    failed_calls: int = 0\\\\n    rejected_calls: int = 0\\\\n    state_transitions: int = 0\\\\n    last_failure_time: Optional[float] = None\\\\n    last_success_time: Optional[float] = None\\\\n    consecutive_failures: int = 0\\\\n    consecutive_successes: int = 0\\\\n\\\\n    @property\\\\n    def failure_rate(self) -> float:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"حساب نسبة الفشل الحالية.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        if self.total_calls == 0:\\\\n            return 0.0\\\\n        return (self.failed_calls / self.total_calls) * 100\\\\n\\\\n    def to_dict(self) -> dict:\\\\n        return {\\\\n            \\\\\\\"total_calls\\\\\\\": self.total_calls,\\\\n            \\\\\\\"successful_calls\\\\\\\": self.successful_calls,\\\\n            \\\\\\\"failed_calls\\\\\\\": self.failed_calls,\\\\n            \\\\\\\"rejected_calls\\\\\\\": self.rejected_calls,\\\\n            \\\\\\\"failure_rate\\\\\\\": f\\\\\\\"{self.failure_rate:.2f}%\\\\\\\",\\\\n            \\\\\\\"consecutive_failures\\\\\\\": self.consecutive_failures,\\\\n            \\\\\\\"consecutive_successes\\\\\\\": self.consecutive_successes,\\\\n        }\\\\n\\\\n\\\\n# ============================================================\\\\n# 5) الكلاس الأساسي: Circuit Breaker\\\\n# ============================================================\\\\nclass CircuitBreaker:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n    تنفيذ كامل لـ Circuit Breaker Pattern مع دعم Asyncio.\\\\n\\\\n    الحالات:\\\\n        CLOSED -> OPEN: عند تجاوز عتبة الفشل\\\\n        OPEN -> HALF_OPEN: بعد انتهاء recovery_timeout\\\\n        HALF_OPEN -> CLOSED: بعد نجاح success_threshold طلبات\\\\n        HALF_OPEN -> OPEN: عند أي فشل\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(\\\\n        self,\\\\n        name: str = \\\\\\\"default\\\\\\\",\\\\n        config: Optional[CircuitBreakerConfig] = None,\\\\n    ):\\\\n        self.name = name\\\\n        self.config = config or CircuitBreakerConfig()\\\\n        self._state = CircuitState.CLOSED\\\\n        self._stats = CircuitStats()\\\\n        self._opened_at: Optional[float] = None\\\\n        self._half_open_calls = 0\\\\n        self._half_open_successes = 0\\\\n        self._lock = asyncio.Lock()\\\\n        logger.info(\\\\n            \\\\\\\"🔧 تهيئة Circuit Breaker '%s' | failure_threshold=%d | recovery_timeout=%.1fs\\\\\\\",\\\\n            name, self.config.failure_threshold, self.config.recovery_timeout,\\\\n        )\\\\n\\\\n    # ----------------------------------------------------\\\\n    # الخصائص (Properties)\\\\n    # ----------------------------------------------------\\\\n    @property\\\\n    def state(self) -> CircuitState:\\\\n        return self._state\\\\n\\\\n    @property\\\\n    def stats(self) -> CircuitStats:\\\\n        return self._stats\\\\n\\\\n    @property\\\\n    def is_closed(self) -> bool:\\\\n        return self._state == CircuitState.CLOSED\\\\n\\\\n    @property\\\\n    def is_open(self) -> bool:\\\\n        return self._state == CircuitState.OPEN\\\\n\\\\n    @property\\\\n    def is_half_open(self) -> bool:\\\\n        return self._state == CircuitState.HALF_OPEN\\\\n\\\\n    # ----------------------------------------------------\\\\n    # إدارة الحالة\\\\n    # ----------------------------------------------------\\\\n    def _should_attempt_reset(self) -> bool:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"هل انتهت مدة الاستراحة للانتقال إلى HALF_OPEN؟\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        if self._opened_at is None:\\\\n            return False\\\\n        return (time.monotonic() - self._opened_at) >= self.config.recovery_timeout\\\\n\\\\n    async def _transition_to_open(self) -> None:\\\\n        async with self._lock:\\\\n            if self._state != CircuitState.OPEN:\\\\n                old = self._state\\\\n                self._state = CircuitState.OPEN\\\\n                self._opened_at = time.monotonic()\\\\n                self._stats.state_transitions += 1\\\\n                logger.warning(\\\\n                    \\\\\\\"🔴 [%s] %s -> OPEN | الفشل: %d/%d | نسبة الفشل: %.1f%%\\\\\\\",\\\\n                    self.name, old.value,\\\\n                    self._stats.consecutive_failures,\\\\n                    self.config.failure_threshold,\\\\n                    self._stats.failure_rate,\\\\n                )\\\\n\\\\n    async def _transition_to_half_open(self) -> None:\\\\n        async with self._lock:\\\\n            old = self._state\\\\n            self._state = CircuitState.HALF_OPEN\\\\n            self._half_open_calls = 0\\\\n            self._half_open_successes = 0\\\\n            self._stats.state_transitions += 1\\\\n            logger.info(\\\\\\\"🟡 [%s] %s -> HALF_OPEN\\\\\\\", self.name, old.value)\\\\n\\\\n    async def _transition_to_closed(self) -> None:\\\\n        async with self._lock:\\\\n            old = self._state\\\\n            self._state = CircuitState.CLOSED\\\\n            self._opened_at = None\\\\n            self._half_open_calls = 0\\\\n            self._half_open_successes = 0\\\\n            self._stats.consecutive_failures = 0\\\\n            self._stats.state_transitions += 1\\\\n            logger.info(\\\\\\\"🟢 [%s] %s -> CLOSED\\\\\\\", self.name, old.value)\\\\n\\\\n    # ----------------------------------------------------\\\\n    # تقييم عتبة الفشل\\\\n    # ----------------------------------------------------\\\\n    def _should_open(self) -> bool:\\\\n        cfg = self.config\\\\n        if self._stats.total_calls < cfg.minimum_calls:\\\\n            return False\\\\n        if self._stats.consecutive_failures >= cfg.failure_threshold:\\\\n            return True\\\\n        if self._stats.failure_rate >= cfg.failure_rate_threshold:\\\\n            return True\\\\n        return False\\\\n\\\\n    # ----------------------------------------------------\\\\n    # استدعاء دالة مع حماية الـ Circuit\\\\n    # ----------------------------------------------------\\\\n    async def call(self, func: Callable[..., Awaitable[T]], *args, **kwargs) -> T:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n        استدعاء دالة async مع حماية الـ Circuit Breaker.\\\\n\\\\n        Args:\\\\n            func: الدالة المراد استدعاؤها\\\\n            *args, **kwargs: معطيات الدالة\\\\n\\\\n        Raises:\\\\n            CircuitOpenError: إذا كان الـ Circuit مفتوحاً\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n        # التحقق من إمكانية الانتقال من OPEN إلى HALF_OPEN\\\\n        if self._state == CircuitState.OPEN:\\\\n            if self._should_attempt_reset():\\\\n                await self._transition_to_half_open()\\\\n            else:\\\\n                self._stats.rejected_calls += 1\\\\n                retry_after = self.config.recovery_timeout - (\\\\n                    time.monotonic() - (self._opened_at or 0)\\\\n                )\\\\n                raise CircuitOpenError(self.name, max(0, retry_after))\\\\n\\\\n        # التحقق من الحد المسموح في HALF_OPEN\\\\n        if self._state == CircuitState.HALF_OPEN:\\\\n            if self._half_open_calls >= self.config.half_open_max_calls:\\\\n                self._stats.rejected_calls += 1\\\\n                raise CircuitOpenError(\\\\n                    self.name, self.config.recovery_timeout,\\\\n                )\\\\n\\\\n        # تنفيذ الدالة\\\\n        if self._state == CircuitState.HALF_OPEN:\\\\n            self._half_open_calls += 1\\\\n\\\\n        self._stats.total_calls += 1\\\\n        try:\\\\n            result = await func(*args, **kwargs)\\\\n        except Exception as exc:\\\\n            await self._on_failure(exc)\\\\n            raise\\\\n        else:\\\\n            await self._on_success()\\\\n            return result\\\\n\\\\n    async def _on_success(self) -> None:\\\\n        self._stats.successful_calls += 1\\\\n        self._stats.last_success_time = time.monotonic()\\\\n        self._stats.consecutive_failures = 0\\\\n        self._stats.consecutive_successes += 1\\\\n\\\\n        if self._state == CircuitState.HALF_OPEN:\\\\n            self._half_open_successes += 1\\\\n            if self._half_open_successes >= self.config.success_threshold:\\\\n                await self._transition_to_closed()\\\\n\\\\n    async def _on_failure(self, exc: Exception) -> None:\\\\n        # تجاهل الاستثناءات المستبعدة\\\\n        if isinstance(exc, self.config.excluded_exceptions):\\\\n            logger.debug(\\\\\\\"⚪ [%s] استثناء مستبعد: %s\\\\\\\", self.name, exc)\\\\n            return\\\\n\\\\n        self._stats.failed_calls += 1\\\\n        self._stats.last_failure_time = time.monotonic()\\\\n        self._stats.consecutive_failures += 1\\\\n        self._stats.consecutive_successes = 0\\\\n\\\\n        logger.error(\\\\n            \\\\\\\"❌ [%s] فشل #%d | %s: %s\\\\\\\",\\\\n            self.name, self._stats.consecutive_failures,\\\\n            type(exc).__name__, exc,\\\\n        )\\\\n\\\\n        # الانتقال إلى OPEN\\\\n        if self._state == CircuitState.HALF_OPEN:\\\\n            await self._transition_to_open()\\\\n        elif self._state == CircuitState.CLOSED and self._should_open():\\\\n            await self._transition_to_open()\\\\n\\\\n    # ----------------------------------------------------\\\\n    # إعادة الضبط اليدوية\\\\n    # ----------------------------------------------------\\\\n    async def reset(self) -> None:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"إعادة ضبط الـ Circuit Breaker إلى الحالة CLOSED.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        async with self._lock:\\\\n            self._state = CircuitState.CLOSED\\\\n            self._opened_at = None\\\\n            self._half_open_calls = 0\\\\n            self._half_open_successes = 0\\\\n            self._stats = CircuitStats()\\\\n            logger.info(\\\\\\\"🔄 [%s] تمت إعادة الضبط\\\\\\\", self.name)\\\\n\\\\n    # ----------------------------------------------------\\\\n    # مزخرف (Decorator)\\\\n    # ----------------------------------------------------\\\\n    def decorator(self, func: Callable[..., Awaitable[T]]) -> Callable[..., Awaitable[T]]:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"استخدام الـ Circuit Breaker كمزخرف للدوال.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n        @wraps(func)\\\\n        async def wrapper(*args, **kwargs) -> T:\\\\n            return await self.call(func, *args, **kwargs)\\\\n\\\\n        return wrapper\\\\n\\\\n\\\\n# ============================================================\\\\n# 6) كلاس Retry مع Exponential Backoff\\\\n# ============================================================\\\\nclass AsyncRetry:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n    تنفيذ كامل لـ Retry مع Exponential Backoff و Jitter.\\\\n\\\\n    صيغة التأخير:\\\\n        delay = min(initial_delay * (base ^ n), max_delay) ± jitter\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(self, config: Optional[RetryConfig] = None):\\\\n        self.config = config or RetryConfig()\\\\n        logger.info(\\\\n            \\\\\\\"♻️  تهيئة Retry | max_attempts=%d | base=%.1f | jitter=%s\\\\\\\",\\\\n            self.config.max_attempts,\\\\n            self.config.exponential_base,\\\\n            \\\\\\\"ON\\\\\\\" if self.config.jitter else \\\\\\\"OFF\\\\\\\",\\\\n        )\\\\n\\\\n    def _calculate_delay(self, attempt: int) -> float:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"حساب التأخير مع Exponential Backoff و Jitter.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        cfg = self.config\\\\n        # Exponential: initial * base^attempt\\\\n        delay = cfg.initial_delay * (cfg.exponential_base ** attempt)\\\\n        delay = min(delay, cfg.max_delay)\\\\n\\\\n        # إضافة Jitter لتجنب thundering herd\\\\n        if cfg.jitter:\\\\n            jitter_amount = delay * cfg.jitter_range\\\\n            delay = delay + random.uniform(-jitter_amount, jitter_amount)\\\\n\\\\n        return max(0, delay)\\\\n\\\\n    async def execute(\\\\n        self,\\\\n        func: Callable[..., Awaitable[T]],\\\\n        *args,\\\\n        **kwargs,\\\\n    ) -> T:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n        تنفيذ دالة مع إعادة المحاولة عند الفشل.\\\\n\\\\n        Args:\\\\n            func: الدالة المراد تنفيذها\\\\n            *args, **kwargs: معطيات الدالة\\\\n\\\\n        Raises:\\\\n            RetryExhaustedError: عند استنفاد كل المحاولات\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n        cfg = self.config\\\\n        last_exception: Optional[Exception] = None\\\\n\\\\n        for attempt in range(1, cfg.max_attempts + 1):\\\\n            try:\\\\n                logger.debug(\\\\\\\"🎯 محاولة %d/%d\\\\\\\", attempt, cfg.max_attempts)\\\\n                return await func(*args, **kwargs)\\\\n\\\\n            except cfg.retry_on as exc:\\\\n                last_exception = exc\\\\n                if attempt >= cfg.max_attempts:\\\\n                    logger.error(\\\\n                        \\\\\\\"💥 استنفاد المحاولات (%d) | آخر خطأ: %s\\\\\\\",\\\\n                        cfg.max_attempts, exc,\\\\n                    )\\\\n                    raise RetryExhaustedError(attempt, exc) from exc\\\\n\\\\n                delay = self._calculate_delay(attempt - 1)\\\\n                logger.warning(\\\\n                    \\\\\\\"⚠️  المحاولة %d/%د فشلت | إعادة بعد %.2fs | %s: %s\\\\\\\",\\\\n                    attempt, cfg.max_attempts, delay,\\\\n                    type(exc).__name__, exc,\\\\n                )\\\\n                await asyncio.sleep(delay)\\\\n\\\\n        # لن نصل هنا أبداً، لكن للأمان\\\\n        raise RetryExhaustedError(cfg.max_attempts, last_exception)\\\\n\\\\n    def decorator(self, func: Callable[..., Awaitable[T]]) -> Callable[..., Awaitable[T]]:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"استخدام الـ Retry كمزخرف للدوال.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n        @wraps(func)\\\\n        async def wrapper(*args, **kwargs) -> T:\\\\n            return await self.execute(func, *args, **kwargs)\\\\n\\\\n        return wrapper\\\\n\\\\n\\\\n# ============================================================\\\\n# 7) التركيب النهائي: CircuitBreaker + Retry\\\\n# ============================================================\\\\nclass ResilientExecutor:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n    يجمع Circuit Breaker + Retry في واجهة واحدة قوية.\\\\n\\\\n    الترتيب:\\\\n        1. Circuit Breaker يحمي من إرسال طلبات لخدمة منهارة\\\\n        2. Retry يحاول عدة مرات قبل تسجيل فشل\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(\\\\n        self,\\\\n        circuit_breaker: CircuitBreaker,\\\\n        retry: Optional[AsyncRetry] = None,\\\\n    ):\\\\n        self.circuit_breaker = circuit_breaker\\\\n        self.retry = retry or AsyncRetry()\\\\n        logger.info(\\\\n            \\\\\\\"🛡️  ResilientExecutor مهيأ لـ '%s'\\\\\\\",\\\\n            circuit_breaker.name,\\\\n        )\\\\n\\\\n    async def execute(\\\\n        self,\\\\n        func: Callable[..., Awaitable[T]],\\\\n        *args,\\\\n        **kwargs,\\\\n    ) -> T:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"تنفيذ الدالة مع الحماية الكاملة.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        return await self.circuit_breaker.call(\\\\n            self.retry.execute, func, *args, **kwargs,\\\\n        )\\\\n\\\\n\\\\n# ============================================================\\\\n# 8) خدمات تجريبية للاختبار\\\\n# ============================================================\\\\nclass FlakyService:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"خدمة محاكاة تتصرف بشكل عشوائي (تستخدم في الاختبارات).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(self, failure_rate: float = 0.5, latency_range: tuple = (0.1, 0.3)):\\\\n        self.failure_rate = failure_rate\\\\n        self.latency_range = latency_range\\\\n        self.call_count = 0\\\\n\\\\n    async def fetch_data(self, query: str) -> dict:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"استدعاء تجريبي يفشل أحياناً.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        self.call_count += 1\\\\n        latency = random.uniform(*self.latency_range)\\\\n        await asyncio.sleep(latency)\\\\n\\\\n        if random.random() < self.failure_rate:\\\\n            raise ConnectionError(f\\\\\\\"فشل الاتصال عند الجلب: {query}\\\\\\\")\\\\n\\\\n        return {\\\\\\\"query\\\\\\\": query, \\\\\\\"result\\\\\\\": f\\\\\\\"بيانات {query}\\\\\\\", \\\\\\\"attempt\\\\\\\": self.call_count}\\\\n\\\\n    async def critical_operation(self, data_id: int) -> dict:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"عملية حرجة قد تفشل.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        await asyncio.sleep(0.1)\\\\n        if data_id < 0:\\\"}\",\"startedAt\":\"2026-08-25T02:44:09.000Z\",\"endedAt\":\"2026-08-25T02:44:09.000Z\",\"thinkingSeconds\":0,\"stepId\":\"step-0\"},{\"type\":\"credit_usage\",\"content\":4,\"startedAt\":\"2026-08-25T02:44:09.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_01a036cdc17b704088701707\",\"name\":\"write_file\",\"args\":{\"file_path\":\"/home/daytona/circuit_breaker_asyncio.py\",\"content\":\"\\\"\\\"\\\"\\nCircuit Breaker Pattern مع Retry و Exponential Backoff\\n=====================================================\\nنظام متكامل باستخدام Asyncio لحماية الخدمات من الانهيار cascading failures.\\n\\nالمميزات:\\n- Circuit Breaker بثلاث حالات (CLOSED, OPEN, HALF_OPEN)\\n- Retry مع Exponential Backoff و Jitter\\n- مراقبة وإحصائيات في الوقت الفعلي\\n- دعم Async/Await كامل\\n- تسجيل مفصل للأحداث\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport asyncio\\nimport logging\\nimport random\\nimport time\\nfrom dataclasses import dataclass, field\\nfrom enum import Enum\\nfrom functools import wraps\\nfrom typing import Any, Awaitable, Callable, Optional, TypeVar, Union\\n\\n# إعداد التسجيل\\nlogging.basicConfig(\\n    level=logging.INFO,\\n    format=\\\"%(asctime)s | %(levelname)-8s | %(name)s | %(message)s\\\",\\n)\\nlogger = logging.getLogger(\\\"CircuitBreaker\\\")\\n\\nT = TypeVar(\\\"T\\\")\\n\\n\\n# ============================================================\\n# 1) تعريف الاستثناءات المخصصة\\n# ============================================================\\nclass CircuitBreakerError(Exception):\\n    \\\"\\\"\\\"الاستثناء الأساسي لنظام Circuit Breaker.\\\"\\\"\\\"\\n\\n\\nclass CircuitOpenError(CircuitBreakerError):\\n    \\\"\\\"\\\"يُطلق عندما يكون الـ Circuit في حالة OPEN.\\\"\\\"\\\"\\n\\n    def __init__(self, breaker_name: str, retry_after: float):\\n        self.breaker_name = breaker_name\\n        self.retry_after = retry_after\\n        super().__init__(\\n            f\\\"Circuit '{breaker_name}' مفتوح. أعد المحاولة بعد {retry_after:.2f} ثانية\\\"\\n        )\\n\\n\\nclass RetryExhaustedError(CircuitBreakerError):\\n    \\\"\\\"\\\"يُطلق عند استنفاد جميع محاولات الـ Retry.\\\"\\\"\\\"\\n\\n    def __init__(self, attempts: int, last_exception: Optional[Exception]):\\n        self.attempts = attempts\\n        self.last_exception = last_exception\\n        msg = f\\\"فشل بعد {attempts} محاولة\\\"\\n        if last_exception:\\n            msg += f\\\" | آخر خطأ: {type(last_exception).__name__}: {last_exception}\\\"\\n        super().__init__(msg)\\n\\n\\n# ============================================================\\n# 2) تعريف حالات الـ Circuit Breaker\\n# ============================================================\\nclass CircuitState(str, Enum):\\n    \\\"\\\"\\\"حالات الـ Circuit Breaker الثلاث.\\\"\\\"\\\"\\n\\n    CLOSED = \\\"CLOSED\\\"            # الحالة الطبيعية - الطلبات تمر\\n    OPEN = \\\"OPEN\\\"                # الحالة المحمية - الطلبات تُرفض فوراً\\n    HALF_OPEN = \\\"HALF_OPEN\\\"      # حالة الاختبار - عدد محدود من الطلبات\\n\\n\\n# ============================================================\\n# 3) إعدادات النظام\\n# ============================================================\\n@dataclass\\nclass CircuitBreakerConfig:\\n    \\\"\\\"\\\"إعدادات الـ Circuit Breaker.\\\"\\\"\\\"\\n\\n    # --- إعدادات الفشل والانتقال إلى OPEN ---\\n    failure_threshold: int = 5            # عدد مرات الفشل لفتح الـ Circuit\\n    failure_rate_threshold: float = 50.0  # نسبة الفشل % لفتح الـ Circuit\\n    minimum_calls: int = 10               # الحد الأدنى من الطلبات قبل التقييم\\n\\n    # --- إعدادات زمن إعادة المحاولة ---\\n    recovery_timeout: float = 30.0        # مدة الانتظار قبل HALF_OPEN (ثانية)\\n    half_open_max_calls: int = 3          # عدد الطلبات المسموح بها في HALF_OPEN\\n\\n    # --- إعدادات إضافية ---\\n    success_threshold: int = 2            # عدد النجاحات لإغلاق الـ Circuit من HALF_OPEN\\n    excluded_exceptions: tuple = ()       # استثناءات لا تُحسب كـ failure\\n\\n\\n@dataclass\\nclass RetryConfig:\\n    \\\"\\\"\\\"إعدادات الـ Retry و Exponential Backoff.\\\"\\\"\\\"\\n\\n    max_attempts: int = 5\\n    initial_delay: float = 1.0            # التأخير الأولي بالثواني\\n    max_delay: float = 60.0               # الحد الأقصى للتأخير\\n    exponential_base: float = 2.0         # أساس المضاعفة\\n    jitter: bool = True                   # إضافة عشوائية لتجنب thundering herd\\n    jitter_range: float = 0.1             # نطاق العشوائية (10%)\\n    retry_on: tuple = (Exception,)        # الاستثناءات التي تستدعي إعادة المحاولة\\n\\n\\n# ============================================================\\n# 4) إحصائيات الـ Circuit Breaker\\n# ============================================================\\n@dataclass\\nclass CircuitStats:\\n    \\\"\\\"\\\"إحصائيات في الوقت الفعلي للـ Circuit Breaker.\\\"\\\"\\\"\\n\\n    total_calls: int = 0\\n    successful_calls: int = 0\\n    failed_calls: int = 0\\n    rejected_calls: int = 0\\n    state_transitions: int = 0\\n    last_failure_time: Optional[float] = None\\n    last_success_time: Optional[float] = None\\n    consecutive_failures: int = 0\\n    consecutive_successes: int = 0\\n\\n    @property\\n    def failure_rate(self) -> float:\\n        \\\"\\\"\\\"حساب نسبة الفشل الحالية.\\\"\\\"\\\"\\n        if self.total_calls == 0:\\n            return 0.0\\n        return (self.failed_calls / self.total_calls) * 100\\n\\n    def to_dict(self) -> dict:\\n        return {\\n            \\\"total_calls\\\": self.total_calls,\\n            \\\"successful_calls\\\": self.successful_calls,\\n            \\\"failed_calls\\\": self.failed_calls,\\n            \\\"rejected_calls\\\": self.rejected_calls,\\n            \\\"failure_rate\\\": f\\\"{self.failure_rate:.2f}%\\\",\\n            \\\"consecutive_failures\\\": self.consecutive_failures,\\n            \\\"consecutive_successes\\\": self.consecutive_successes,\\n        }\\n\\n\\n# ============================================================\\n# 5) الكلاس الأساسي: Circuit Breaker\\n# ============================================================\\nclass CircuitBreaker:\\n    \\\"\\\"\\\"\\n    تنفيذ كامل لـ Circuit Breaker Pattern مع دعم Asyncio.\\n\\n    الحالات:\\n        CLOSED -> OPEN: عند تجاوز عتبة الفشل\\n        OPEN -> HALF_OPEN: بعد انتهاء recovery_timeout\\n        HALF_OPEN -> CLOSED: بعد نجاح success_threshold طلبات\\n        HALF_OPEN -> OPEN: عند أي فشل\\n    \\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        name: str = \\\"default\\\",\\n        config: Optional[CircuitBreakerConfig] = None,\\n    ):\\n        self.name = name\\n        self.config = config or CircuitBreakerConfig()\\n        self._state = CircuitState.CLOSED\\n        self._stats = CircuitStats()\\n        self._opened_at: Optional[float] = None\\n        self._half_open_calls = 0\\n        self._half_open_successes = 0\\n        self._lock = asyncio.Lock()\\n        logger.info(\\n            \\\"🔧 تهيئة Circuit Breaker '%s' | failure_threshold=%d | recovery_timeout=%.1fs\\\",\\n            name, self.config.failure_threshold, self.config.recovery_timeout,\\n        )\\n\\n    # ----------------------------------------------------\\n    # الخصائص (Properties)\\n    # ----------------------------------------------------\\n    @property\\n    def state(self) -> CircuitState:\\n        return self._state\\n\\n    @property\\n    def stats(self) -> CircuitStats:\\n        return self._stats\\n\\n    @property\\n    def is_closed(self) -> bool:\\n        return self._state == CircuitState.CLOSED\\n\\n    @property\\n    def is_open(self) -> bool:\\n        return self._state == CircuitState.OPEN\\n\\n    @property\\n    def is_half_open(self) -> bool:\\n        return self._state == CircuitState.HALF_OPEN\\n\\n    # ----------------------------------------------------\\n    # إدارة الحالة\\n    # ----------------------------------------------------\\n    def _should_attempt_reset(self) -> bool:\\n        \\\"\\\"\\\"هل انتهت مدة الاستراحة للانتقال إلى HALF_OPEN؟\\\"\\\"\\\"\\n        if self._opened_at is None:\\n            return False\\n        return (time.monotonic() - self._opened_at) >= self.config.recovery_timeout\\n\\n    async def _transition_to_open(self) -> None:\\n        async with self._lock:\\n            if self._state != CircuitState.OPEN:\\n                old = self._state\\n                self._state = CircuitState.OPEN\\n                self._opened_at = time.monotonic()\\n                self._stats.state_transitions += 1\\n                logger.warning(\\n                    \\\"🔴 [%s] %s -> OPEN | الفشل: %d/%d | نسبة الفشل: %.1f%%\\\",\\n                    self.name, old.value,\\n                    self._stats.consecutive_failures,\\n                    self.config.failure_threshold,\\n                    self._stats.failure_rate,\\n                )\\n\\n    async def _transition_to_half_open(self) -> None:\\n        async with self._lock:\\n            old = self._state\\n            self._state = CircuitState.HALF_OPEN\\n            self._half_open_calls = 0\\n            self._half_open_successes = 0\\n            self._stats.state_transitions += 1\\n            logger.info(\\\"🟡 [%s] %s -> HALF_OPEN\\\", self.name, old.value)\\n\\n    async def _transition_to_closed(self) -> None:\\n        async with self._lock:\\n            old = self._state\\n            self._state = CircuitState.CLOSED\\n            self._opened_at = None\\n            self._half_open_calls = 0\\n            self._half_open_successes = 0\\n            self._stats.consecutive_failures = 0\\n            self._stats.state_transitions += 1\\n            logger.info(\\\"🟢 [%s] %s -> CLOSED\\\", self.name, old.value)\\n\\n    # ----------------------------------------------------\\n    # تقييم عتبة الفشل\\n    # ----------------------------------------------------\\n    def _should_open(self) -> bool:\\n        cfg = self.config\\n        if self._stats.total_calls < cfg.minimum_calls:\\n            return False\\n        if self._stats.consecutive_failures >= cfg.failure_threshold:\\n            return True\\n        if self._stats.failure_rate >= cfg.failure_rate_threshold:\\n            return True\\n        return False\\n\\n    # ----------------------------------------------------\\n    # استدعاء دالة مع حماية الـ Circuit\\n    # ----------------------------------------------------\\n    async def call(self, func: Callable[..., Awaitable[T]], *args, **kwargs) -> T:\\n        \\\"\\\"\\\"\\n        استدعاء دالة async مع حماية الـ Circuit Breaker.\\n\\n        Args:\\n            func: الدالة المراد استدعاؤها\\n            *args, **kwargs: معطيات الدالة\\n\\n        Raises:\\n            CircuitOpenError: إذا كان الـ Circuit مفتوحاً\\n        \\\"\\\"\\\"\\n        # التحقق من إمكانية الانتقال من OPEN إلى HALF_OPEN\\n        if self._state == CircuitState.OPEN:\\n            if self._should_attempt_reset():\\n                await self._transition_to_half_open()\\n            else:\\n                self._stats.rejected_calls += 1\\n                retry_after = self.config.recovery_timeout - (\\n                    time.monotonic() - (self._opened_at or 0)\\n                )\\n                raise CircuitOpenError(self.name, max(0, retry_after))\\n\\n        # التحقق من الحد المسموح في HALF_OPEN\\n        if self._state == CircuitState.HALF_OPEN:\\n            if self._half_open_calls >= self.config.half_open_max_calls:\\n                self._stats.rejected_calls += 1\\n                raise CircuitOpenError(\\n                    self.name, self.config.recovery_timeout,\\n                )\\n\\n        # تنفيذ الدالة\\n        if self._state == CircuitState.HALF_OPEN:\\n            self._half_open_calls += 1\\n\\n        self._stats.total_calls += 1\\n        try:\\n            result = await func(*args, **kwargs)\\n        except Exception as exc:\\n            await self._on_failure(exc)\\n            raise\\n        else:\\n            await self._on_success()\\n            return result\\n\\n    async def _on_success(self) -> None:\\n        self._stats.successful_calls += 1\\n        self._stats.last_success_time = time.monotonic()\\n        self._stats.consecutive_failures = 0\\n        self._stats.consecutive_successes += 1\\n\\n        if self._state == CircuitState.HALF_OPEN:\\n            self._half_open_successes += 1\\n            if self._half_open_successes >= self.config.success_threshold:\\n                await self._transition_to_closed()\\n\\n    async def _on_failure(self, exc: Exception) -> None:\\n        # تجاهل الاستثناءات المستبعدة\\n        if isinstance(exc, self.config.excluded_exceptions):\\n            logger.debug(\\\"⚪ [%s] استثناء مستبعد: %s\\\", self.name, exc)\\n            return\\n\\n        self._stats.failed_calls += 1\\n        self._stats.last_failure_time = time.monotonic()\\n        self._stats.consecutive_failures += 1\\n        self._stats.consecutive_successes = 0\\n\\n        logger.error(\\n            \\\"❌ [%s] فشل #%d | %s: %s\\\",\\n            self.name, self._stats.consecutive_failures,\\n            type(exc).__name__, exc,\\n        )\\n\\n        # الانتقال إلى OPEN\\n        if self._state == CircuitState.HALF_OPEN:\\n            await self._transition_to_open()\\n        elif self._state == CircuitState.CLOSED and self._should_open():\\n            await self._transition_to_open()\\n\\n    # ----------------------------------------------------\\n    # إعادة الضبط اليدوية\\n    # ----------------------------------------------------\\n    async def reset(self) -> None:\\n        \\\"\\\"\\\"إعادة ضبط الـ Circuit Breaker إلى الحالة CLOSED.\\\"\\\"\\\"\\n        async with self._lock:\\n            self._state = CircuitState.CLOSED\\n            self._opened_at = None\\n            self._half_open_calls = 0\\n            self._half_open_successes = 0\\n            self._stats = CircuitStats()\\n            logger.info(\\\"🔄 [%s] تمت إعادة الضبط\\\", self.name)\\n\\n    # ----------------------------------------------------\\n    # مزخرف (Decorator)\\n    # ----------------------------------------------------\\n    def decorator(self, func: Callable[..., Awaitable[T]]) -> Callable[..., Awaitable[T]]:\\n        \\\"\\\"\\\"استخدام الـ Circuit Breaker كمزخرف للدوال.\\\"\\\"\\\"\\n\\n        @wraps(func)\\n        async def wrapper(*args, **kwargs) -> T:\\n            return await self.call(func, *args, **kwargs)\\n\\n        return wrapper\\n\\n\\n# ============================================================\\n# 6) كلاس Retry مع Exponential Backoff\\n# ============================================================\\nclass AsyncRetry:\\n    \\\"\\\"\\\"\\n    تنفيذ كامل لـ Retry مع Exponential Backoff و Jitter.\\n\\n    صيغة التأخير:\\n        delay = min(initial_delay * (base ^ n), max_delay) ± jitter\\n    \\\"\\\"\\\"\\n\\n    def __init__(self, config: Optional[RetryConfig] = None):\\n        self.config = config or RetryConfig()\\n        logger.info(\\n            \\\"♻️  تهيئة Retry | max_attempts=%d | base=%.1f | jitter=%s\\\",\\n            self.config.max_attempts,\\n            self.config.exponential_base,\\n            \\\"ON\\\" if self.config.jitter else \\\"OFF\\\",\\n        )\\n\\n    def _calculate_delay(self, attempt: int) -> float:\\n        \\\"\\\"\\\"حساب التأخير مع Exponential Backoff و Jitter.\\\"\\\"\\\"\\n        cfg = self.config\\n        # Exponential: initial * base^attempt\\n        delay = cfg.initial_delay * (cfg.exponential_base ** attempt)\\n        delay = min(delay, cfg.max_delay)\\n\\n        # إضافة Jitter لتجنب thundering herd\\n        if cfg.jitter:\\n            jitter_amount = delay * cfg.jitter_range\\n            delay = delay + random.uniform(-jitter_amount, jitter_amount)\\n\\n        return max(0, delay)\\n\\n    async def execute(\\n        self,\\n        func: Callable[..., Awaitable[T]],\\n        *args,\\n        **kwargs,\\n    ) -> T:\\n        \\\"\\\"\\\"\\n        تنفيذ دالة مع إعادة المحاولة عند الفشل.\\n\\n        Args:\\n            func: الدالة المراد تنفيذها\\n            *args, **kwargs: معطيات الدالة\\n\\n        Raises:\\n            RetryExhaustedError: عند استنفاد كل المحاولات\\n        \\\"\\\"\\\"\\n        cfg = self.config\\n        last_exception: Optional[Exception] = None\\n\\n        for attempt in range(1, cfg.max_attempts + 1):\\n            try:\\n                logger.debug(\\\"🎯 محاولة %d/%d\\\", attempt, cfg.max_attempts)\\n                return await func(*args, **kwargs)\\n\\n            except cfg.retry_on as exc:\\n                last_exception = exc\\n                if attempt >= cfg.max_attempts:\\n                    logger.error(\\n                        \\\"💥 استنفاد المحاولات (%d) | آخر خطأ: %s\\\",\\n                        cfg.max_attempts, exc,\\n                    )\\n                    raise RetryExhaustedError(attempt, exc) from exc\\n\\n                delay = self._calculate_delay(attempt - 1)\\n                logger.warning(\\n                    \\\"⚠️  المحاولة %d/%د فشلت | إعادة بعد %.2fs | %s: %s\\\",\\n                    attempt, cfg.max_attempts, delay,\\n                    type(exc).__name__, exc,\\n                )\\n                await asyncio.sleep(delay)\\n\\n        # لن نصل هنا أبداً، لكن للأمان\\n        raise RetryExhaustedError(cfg.max_attempts, last_exception)\\n\\n    def decorator(self, func: Callable[..., Awaitable[T]]) -> Callable[..., Awaitable[T]]:\\n        \\\"\\\"\\\"استخدام الـ Retry كمزخرف للدوال.\\\"\\\"\\\"\\n\\n        @wraps(func)\\n        async def wrapper(*args, **kwargs) -> T:\\n            return await self.execute(func, *args, **kwargs)\\n\\n        return wrapper\\n\\n\\n# ============================================================\\n# 7) التركيب النهائي: CircuitBreaker + Retry\\n# ============================================================\\nclass ResilientExecutor:\\n    \\\"\\\"\\\"\\n    يجمع Circuit Breaker + Retry في واجهة واحدة قوية.\\n\\n    الترتيب:\\n        1. Circuit Breaker يحمي من إرسال طلبات لخدمة منهارة\\n        2. Retry يحاول عدة مرات قبل تسجيل فشل\\n    \\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        circuit_breaker: CircuitBreaker,\\n        retry: Optional[AsyncRetry] = None,\\n    ):\\n        self.circuit_breaker = circuit_breaker\\n        self.retry = retry or AsyncRetry()\\n        logger.info(\\n            \\\"🛡️  ResilientExecutor مهيأ لـ '%s'\\\",\\n            circuit_breaker.name,\\n        )\\n\\n    async def execute(\\n        self,\\n        func: Callable[..., Awaitable[T]],\\n        *args,\\n        **kwargs,\\n    ) -> T:\\n        \\\"\\\"\\\"تنفيذ الدالة مع الحماية الكاملة.\\\"\\\"\\\"\\n        return await self.circuit_breaker.call(\\n            self.retry.execute, func, *args, **kwargs,\\n        )\\n\\n\\n# ============================================================\\n# 8) خدمات تجريبية للاختبار\\n# ============================================================\\nclass FlakyService:\\n    \\\"\\\"\\\"خدمة محاكاة تتصرف بشكل عشوائي (تستخدم في الاختبارات).\\\"\\\"\\\"\\n\\n    def __init__(self, failure_rate: float = 0.5, latency_range: tuple = (0.1, 0.3)):\\n        self.failure_rate = failure_rate\\n        self.latency_range = latency_range\\n        self.call_count = 0\\n\\n    async def fetch_data(self, query: str) -> dict:\\n        \\\"\\\"\\\"استدعاء تجريبي يفشل أحياناً.\\\"\\\"\\\"\\n        self.call_count += 1\\n        latency = random.uniform(*self.latency_range)\\n        await asyncio.sleep(latency)\\n\\n        if random.random() < self.failure_rate:\\n            raise ConnectionError(f\\\"فشل الاتصال عند الجلب: {query}\\\")\\n\\n        return {\\\"query\\\": query, \\\"result\\\": f\\\"بيانات {query}\\\", \\\"attempt\\\": self.call_count}\\n\\n    async def critical_operation(self, data_id: int) -> dict:\\n        \\\"\\\"\\\"عملية حرجة قد تفشل.\\\"\\\"\\\"\\n        await asyncio.sleep(0.1)\\n        if data_id < 0:\",\"__result\":\"Updated file /home/daytona/circuit_breaker_asyncio.py\"},\"result\":\"Updated file /home/daytona/circuit_breaker_asyncio.py\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:44:09.000Z\",\"stepId\":\"step-0\",\"endedAt\":\"2026-08-25T02:44:11.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_01a036cdc17b704088701707\",\"name\":\"write_file\",\"content\":\"Updated file /home/daytona/circuit_breaker_asyncio.py\"},\"startedAt\":\"2026-08-25T02:44:11.000Z\",\"endedAt\":\"2026-08-25T02:44:11.000Z\"},{\"type\":\"credit_usage\",\"content\":4,\"startedAt\":\"2026-08-25T02:44:12.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_01a036cdcf3c7962a4559b6c\",\"name\":\"write_todos\",\"args\":{\"todos\":[{\"content\":\"تصميم هيكل المشروع والكلاسات الأساسية\",\"status\":\"completed\"},{\"content\":\"كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)\",\"status\":\"completed\"},{\"content\":\"إضافة آلية Retry مع Exponential Backoff و Jitter\",\"status\":\"completed\"},{\"content\":\"إنشاء أمثلة عملية واختبارات توضيحية\",\"status\":\"in_progress\"},{\"content\":\"رفع الملف للمستخدم\",\"status\":\"pending\"}],\"__result\":\"Updated todo list to [{'content': 'تصميم هيكل المشروع والكلاسات الأساسية', 'status': 'completed'}, {'content': 'كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)', 'status': 'completed'}, {'content': 'إضافة آلية Retry مع Exponential Backoff و Jitter', 'status': 'completed'}, {'content': 'إنشاء أمثلة عملية واختبارات توضيحية', 'status': 'in_progress'}, {'content': 'رفع الملف للمستخدم', 'status': 'pending'}]\"},\"result\":\"Updated todo list to [{'content': 'تصميم هيكل المشروع والكلاسات الأساسية', 'status': 'completed'}, {'content': 'كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)', 'status': 'completed'}, {'content': 'إضافة آلية Retry مع Exponential Backoff و Jitter', 'status': 'completed'}, {'content': 'إنشاء أمثلة عملية واختبارات توضيحية', 'status': 'in_progress'}, {'content': 'رفع الملف للمستخدم', 'status': 'pending'}]\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:44:12.000Z\",\"endedAt\":\"2026-08-25T02:44:12.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_01a036cdcf3c7962a4559b6c\",\"name\":\"write_todos\",\"content\":\"Updated todo list to [{'content': 'تصميم هيكل المشروع والكلاسات الأساسية', 'status': 'completed'}, {'content': 'كتابة كود Circuit Breaker مع الحالات الثلاث (CLOSED, OPEN, HALF_OPEN)', 'status': 'completed'}, {'content': 'إضافة آلية Retry مع Exponential Backoff و Jitter', 'status': 'completed'}, {'content': 'إنشاء أمثلة عملية واختبارات توضيحية', 'status': 'in_progress'}, {'content': 'رفع الملف للمستخدم', 'status': 'pending'}]\"},\"startedAt\":\"2026-08-25T02:44:12.000Z\",\"endedAt\":\"2026-08-25T02:44:12.000Z\"},{\"type\":\"text\",\"content\":\"سأكمل الآن بقية الملف مع الأمثلة العملية:\",\"startedAt\":\"2026-08-25T02:44:13.000Z\",\"stepId\":\"step-3\",\"endedAt\":\"2026-08-25T02:44:13.000Z\"},{\"type\":\"credit_usage\",\"content\":6,\"startedAt\":\"2026-08-25T02:44:32.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_01a036ce1af8728185583998\",\"name\":\"edit_file\",\"args\":{\"file_path\":\"/home/daytona/circuit_breaker_asyncio.py\",\"old_string\":\"async def critical_operation(self, data_id: int) -> dict:\\n        \\\"\\\"\\\"عملية حرجة قد تفشل.\\\"\\\"\\\"\\n        await asyncio.sleep(0.1)\\n        if data_id < 0:\",\"new_string\":\"async def critical_operation(self, data_id: int) -> dict:\\n        \\\"\\\"\\\"عملية حرجة قد تفشل.\\\"\\\"\\\"\\n        await asyncio.sleep(0.1)\\n        if data_id < 0:\\n            raise ValueError(f\\\"معرف غير صالح: {data_id}\\\")\\n        return {\\\"id\\\": data_id, \\\"status\\\": \\\"ok\\\"}\\n\\n\\n# ============================================================\\n# 9) أمثلة توضيحية شاملة\\n# ============================================================\\nasync def example_basic_circuit_breaker():\\n    \\\"\\\"\\\"مثال 1: استخدام Circuit Breaker بشكل أساسي.\\\"\\\"\\\"\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n    print(\\\"📘 مثال 1: Circuit Breaker الأساسي\\\")\\n    print(\\\"=\\\" * 70)\\n\\n    cb = CircuitBreaker(\\n        name=\\\"API-Service\\\",\\n        config=CircuitBreakerConfig(\\n            failure_threshold=3,\\n            failure_rate_threshold=50.0,\\n            minimum_calls=5,\\n            recovery_timeout=2.0,\\n            half_open_max_calls=2,\\n        ),\\n    )\\n\\n    service = FlakyService(failure_rate=0.7)\\n\\n    # تنفيذ 10 طلبات\\n    for i in range(10):\\n        try:\\n            result = await cb.call(service.fetch_data, f\\\"req-{i}\\\")\\n            print(f\\\"  ✅ طلب {i}: نجح -> {result}\\\")\\n        except CircuitOpenError as e:\\n            print(f\\\"  🚫 طلب {i}: Circuit مفتوح -> {e}\\\")\\n        except Exception as e:\\n            print(f\\\"  ❌ طلب {i}: فشل -> {type(e).__name__}\\\")\\n        await asyncio.sleep(0.1)\\n\\n    # انتظار recovery والاختبار\\n    print(f\\\"\\\\n  ⏳ انتظار {cb.config.recovery_timeout}ث...\\\")\\n    await asyncio.sleep(cb.config.recovery_timeout + 0.5)\\n\\n    print(\\\"\\\\n  🔄 محاولة استعادة (HALF_OPEN):\\\")\\n    for i in range(3):\\n        try:\\n            result = await cb.call(service.fetch_data, f\\\"recovery-{i}\\\")\\n            print(f\\\"  ✅ طلب {i}: نجح -> {result}\\\")\\n        except CircuitOpenError as e:\\n            print(f\\\"  🚫 طلب {i}: مرفوض -> {e.retry_after:.2f}ث\\\")\\n        except Exception as e:\\n            print(f\\\"  ❌ طلب {i}: فشل -> {type(e).__name__}\\\")\\n\\n    print(f\\\"\\\\n  📊 الإحصائيات النهائية: {cb.stats.to_dict()}\\\")\\n\\n\\nasync def example_retry_with_backoff():\\n    \\\"\\\"\\\"مثال 2: Exponential Backoff مع Jitter.\\\"\\\"\\\"\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n    print(\\\"📘 مثال 2: Retry مع Exponential Backoff\\\")\\n    print(\\\"=\\\" * 70)\\n\\n    retry = AsyncRetry(\\n        config=RetryConfig(\\n            max_attempts=5,\\n            initial_delay=0.5,\\n            max_delay=10.0,\\n            exponential_base=2.0,\\n            jitter=True,\\n            jitter_range=0.2,\\n        ),\\n    )\\n\\n    # دالة تفشل في أول 3 محاولات ثم تنجح\\n    attempt_counter = [0]\\n\\n    async def unreliable_service():\\n        attempt_counter[0] += 1\\n        await asyncio.sleep(0.05)\\n        if attempt_counter[0] < 4:\\n            raise ConnectionError(f\\\"فشل المحاولة {attempt_counter[0]}\\\")\\n        return {\\\"data\\\": \\\"نجح بعد عدة محاولات\\\", \\\"attempts\\\": attempt_counter[0]}\\n\\n    start = time.monotonic()\\n    try:\\n        result = await retry.execute(unreliable_service)\\n        elapsed = time.monotonic() - start\\n        print(f\\\"  ✅ النتيجة: {result}\\\")\\n        print(f\\\"  ⏱️  الوقت الكلي: {elapsed:.2f}ث\\\")\\n    except RetryExhaustedError as e:\\n        print(f\\\"  💥 فشل: {e}\\\")\\n\\n    # عرض جدول التأخيرات\\n    print(\\\"\\\\n  📐 جدول التأخيرات المتوقع:\\\")\\n    for i in range(5):\\n        delay = retry._calculate_delay(i)\\n        print(f\\\"     المحاولة {i+1}: {delay:.3f}ث\\\")\\n\\n\\nasync def example_resilient_executor():\\n    \\\"\\\"\\\"مثال 3: التركيب الكامل - Circuit Breaker + Retry.\\\"\\\"\\\"\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n    print(\\\"📘 مثال 3: ResilientExecutor (CB + Retry)\\\")\\n    print(\\\"=\\\" * 70)\\n\\n    cb = CircuitBreaker(\\n        name=\\\"Database\\\",\\n        config=CircuitBreakerConfig(\\n            failure_threshold=4,\\n            minimum_calls=3,\\n            recovery_timeout=3.0,\\n        ),\\n    )\\n    retry = AsyncRetry(\\n        config=RetryConfig(\\n            max_attempts=3,\\n            initial_delay=0.3,\\n            exponential_base=2.0,\\n            jitter=True,\\n        ),\\n    )\\n    executor = ResilientExecutor(cb, retry)\\n\\n    service = FlakyService(failure_rate=0.6)\\n\\n    # تنفيذ عدة طلبات\\n    for i in range(8):\\n        try:\\n            result = await executor.execute(\\n                service.fetch_data, f\\\"db-query-{i}\\\",\\n            )\\n            print(f\\\"  [{i}] ✅ نجح: {result['result']}\\\")\\n        except CircuitOpenError as e:\\n            print(f\\\"  [{i}] 🚫 Circuit مفتوح: أعد بعد {e.retry_after:.2f}ث\\\")\\n        except RetryExhaustedError as e:\\n            print(f\\\"  [{i}] 🔄 استنفاد الإعادة: {e}\\\")\\n        except Exception as e:\\n            print(f\\\"  [{i}] ❌ خطأ: {type(e).__name__}: {e}\\\")\\n\\n        await asyncio.sleep(0.2)\\n\\n    print(f\\\"\\\\n  📊 حالة الـ Circuit: {cb.state.value}\\\")\\n    print(f\\\"  📊 الإحصائيات: {cb.stats.to_dict()}\\\")\\n\\n\\nasync def example_decorator_usage():\\n    \\\"\\\"\\\"مثال 4: استخدام المزخرفات (Decorators).\\\"\\\"\\\"\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n    print(\\\"📘 مثال 4: استخدام Decorators\\\")\\n    print(\\\"=\\\" * 70)\\n\\n    cb = CircuitBreaker(\\n        name=\\\"PaymentAPI\\\",\\n        config=CircuitBreakerConfig(\\n            failure_threshold=3,\\n            minimum_calls=2,\\n            recovery_timeout=2.0,\\n        ),\\n    )\\n    retry = AsyncRetry(\\n        config=RetryConfig(max_attempts=3, initial_delay=0.2),\\n    )\\n\\n    @cb.decorator\\n    @retry.decorator\\n    async def process_payment(amount: float, user_id: int) -> dict:\\n        \\\"\\\"\\\"معالجة عملية دفع (محمية بالـ CB + Retry).\\\"\\\"\\\"\\n        await asyncio.sleep(0.1)\\n        if random.random() < 0.4:\\n            raise ConnectionError(\\\"فشل بوابة الدفع\\\")\\n        return {\\n            \\\"user_id\\\": user_id,\\n            \\\"amount\\\": amount,\\n            \\\"status\\\": \\\"completed\\\",\\n            \\\"tx_id\\\": f\\\"tx-{random.randint(1000, 9999)}\\\",\\n        }\\n\\n    for i in range(6):\\n        try:\\n            result = await process_payment(99.99, user_id=i + 1)\\n            print(f\\\"  💳 دفعة {i+1}: ✅ {result['status']} ({result['tx_id']})\\\")\\n        except (CircuitOpenError, RetryExhaustedError) as e:\\n            print(f\\\"  💳 دفعة {i+1}: ❌ {type(e).__name__}\\\")\\n        await asyncio.sleep(0.15)\\n\\n    print(f\\\"\\\\n  📊 حالة الـ PaymentAPI: {cb.state.value}\\\")\\n\\n\\nasync def example_concurrent_requests():\\n    \\\"\\\"\\\"مثال 5: طلبات متزامنة (Concurrency).\\\"\\\"\\\"\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n    print(\\\"📘 مثال 5: طلبات متزامنة (Asyncio)\\\")\\n    print(\\\"=\\\" * 70)\\n\\n    cb = CircuitBreaker(\\n        name=\\\"HighTrafficAPI\\\",\\n        config=CircuitBreakerConfig(\\n            failure_threshold=5,\\n            minimum_calls=5,\\n            recovery_timeout=2.0,\\n        ),\\n    )\\n\\n    async def task(task_id: int):\\n        try:\\n            await asyncio.sleep(random.uniform(0.05, 0.2))\\n            await cb.call(slow_api_call, task_id)\\n            return task_id, \\\"success\\\"\\n        except Exception as e:\\n            return task_id, type(e).__name__\\n\\n    async def slow_api_call(task_id: int):\\n        await asyncio.sleep(0.1)\\n        if random.random() < 0.4:\\n            raise ConnectionError(f\\\"خطأ في المهمة {task_id}\\\")\\n        return f\\\"نجحت المهمة {task_id}\\\"\\n\\n    # تنفيذ 20 مهمة بالتوازي\\n    start = time.monotonic()\\n    results = await asyncio.gather(*[task(i) for i in range(20)])\\n    elapsed = time.monotonic() - start\\n\\n    success = sum(1 for _, s in results if s == \\\"success\\\")\\n    rejected = sum(1 for _, s in results if s == \\\"CircuitOpenError\\\")\\n    failed = len(results) - success - rejected\\n\\n    print(f\\\"  ⚡ 20 مهمة متزامنة في {elapsed:.2f}ث\\\")\\n    print(f\\\"  ✅ نجاح: {success} | ❌ فشل: {failed} | 🚫 مرفوض: {rejected}\\\")\\n    print(f\\\"  📊 حالة الـ Circuit: {cb.state.value}\\\")\\n    print(f\\\"  📊 الإحصائيات: {cb.stats.to_dict()}\\\")\\n\\n\\n# ============================================================\\n# 10) نقطة الدخول الرئيسية\\n# ============================================================\\nasync def main():\\n    \\\"\\\"\\\"تشغيل جميع الأمثلة التوضيحية.\\\"\\\"\\\"\\n    print(\\\"🚀 بدء تشغيل أمثلة Circuit Breaker + Retry\\\")\\n    print(\\\"=\\\" * 70)\\n\\n    examples = [\\n        (\\\"Circuit Breaker الأساسي\\\", example_basic_circuit_breaker),\\n        (\\\"Retry مع Exponential Backoff\\\", example_retry_with_backoff),\\n        (\\\"ResilientExecutor\\\", example_resilient_executor),\\n        (\\\"استخدام Decorators\\\", example_decorator_usage),\\n        (\\\"طلبات متزامنة\\\", example_concurrent_requests),\\n    ]\\n\\n    for title, example_func in examples:\\n        try:\\n            await example_func()\\n        except Exception as e:\\n            print(f\\\"  💥 خطأ غير متوقع في '{title}': {e}\\\")\\n            logger.exception(\\\"خطأ في المثال\\\")\\n\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 70)\\n    print(\\\"✅ اكتملت جميع الأمثلة بنجاح\\\")\\n    print(\\\"=\\\" * 70)\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    # تشغيل الحلقة الرئيسية\\n    try:\\n        asyncio.run(main())\\n    except KeyboardInterrupt:\\n        print(\\\"\\\\n⚠️  تم إيقاف البرنامج بواسطة المستخدم\\\")\",\"__result\":\"Successfully replaced 1 instance(s) of the string in '/home/daytona/circuit_breaker_asyncio.py'\"},\"result\":\"Successfully replaced 1 instance(s) of the string in '/home/daytona/circuit_breaker_asyncio.py'\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:44:32.000Z\",\"stepId\":\"step-3\",\"endedAt\":\"2026-08-25T02:44:33.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_01a036ce1af8728185583998\",\"name\":\"edit_file\",\"content\":\"Successfully replaced 1 instance(s) of the string in '/home/daytona/circuit_breaker_asyncio.py'\"},\"startedAt\":\"2026-08-25T02:44:33.000Z\",\"endedAt\":\"2026-08-25T02:44:33.000Z\"},{\"type\":\"text\",\"content\":\"الآن دعني أتحقق من صحة الكود بتشغيله:\",\"startedAt\":\"2026-08-25T02:44:34.000Z\",\"stepId\":\"step-3\",\"endedAt\":\"2026-08-25T02:44:34.000Z\"},{\"type\":\"credit_usage\",\"content\":6,\"startedAt\":\"2026-08-25T02:44:35.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_01a036ce26df79b0a308be53\",\"name\":\"execute\",\"args\":{\"command\":\"cd /home/daytona && python3 -c \\\"import ast; ast.parse(open('circuit_breaker_asyncio.py').read()); print('✅ الكود صحيح نحوياً')\\\"\",\"__result\":\"✅ الكود صحيح نحوياً\\n\\n[Command succeeded with exit code 0]\"},\"result\":\"✅ الكود صحيح نحوياً\\n\\n[Command succeeded with exit code 0]\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:44:35.000Z\",\"stepId\":\"step-3\",\"endedAt\":\"2026-08-25T02:44:36.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_01a036ce26df79b0a308be53\",\"name\":\"execute\",\"content\":\"✅ الكود صحيح نحوياً\\n\\n[Command succeeded with exit code 0]\"},\"startedAt\":\"2026-08-25T02:44:36.000Z\",\"endedAt\":\"2026-08-25T02:44:36.000Z\"},{\"type\":\"credit_usage\",\"content\":7,\"startedAt\":\"2026-08-25T02:44:38.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_01a036ce317d7360868e11ff\",\"name\":\"execute\",\"args\":{\"command\":\"cd /home