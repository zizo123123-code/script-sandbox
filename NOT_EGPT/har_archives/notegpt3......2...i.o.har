\" كبير\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"اً\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" من\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" الط\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"ل\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"بات\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" من\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" الو\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"صول\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" لل\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"بو\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"ابة\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" أص\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"لاً\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \")\\\\\\\"\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \")\\\\n\\\\n\\\\n\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"if\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" __\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"name\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"__\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" ==\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" \\\\\\\"__\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"main\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"__\\\\\\\":\\\\n\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"   \", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" as\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"yn\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"cio\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \".run\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"(m\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"ain\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"())\\\\n\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"\\\"\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \", \", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"\\\"\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"file\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"_path\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"\\\"\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \": \", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"\\\"\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"/\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"home\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"/day\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"ton\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"a\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"/as\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"yn\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"cio\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"_c\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"irc\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"uit\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"_\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"breaker\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"/ex\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"amples\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"/d\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"emo\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \".py\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"\\\"\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"}\", \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"credit_usage\", \"data\": {\"credits\": 3}, \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"tool_call\", \"data\": {\"name\": \"write_file\", \"args\": {\"content\": \"\\\"\\\"\\\"\\nDemo: Circuit Breaker + Retry (Exponential Backoff) مع asyncio.\\n\\nنحاكي خدمة خارجية غير مستقرة (HTTP API) ونحميها بطبقات المرونة الثلاث:\\n  1) Circuit Breaker  -> يوقف الضرب على الخدمة عند تكرار الفشل (fail-fast).\\n  2) Retry            -> يعيد المحاولة مع تأخير أُسّي (exponential backoff) + جitter.\\n  3) Timeout          -> مهلة زمنية لكل محاولة حتى لا يعلق الطلب للأبد.\\n\\nشغّل المثال:  python examples/demo.py\\n\\\"\\\"\\\"\\n\\nimport asyncio\\nimport random\\nimport sys\\nfrom pathlib import Path\\n\\n# نضيف جذر المشروع إلى مسار الاستيراد حتى يعمل المثال من أي مكان\\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\\n\\nfrom circuit_breaker import (\\n    CircuitBreaker,\\n    CircuitOpenError,\\n    RetryExhaustedError,\\n    RetryPolicy,\\n    resilient,\\n)\\n\\n# --------------------------------------------------------------------------- #\\n# 1) محاكاة خدمة خارجية غير مستقرة\\n# --------------------------------------------------------------------------- #\\nclass FakePaymentGateway:\\n    \\\"\\\"\\\"محاكاة بوابة دفع: نسبة فشل عشوائية + أوقات استجابة متفاوتة.\\\"\\\"\\\"\\n\\n    def __init__(self, failure_rate: float = 0.6, latency: float = 0.3) -> None:\\n        self.failure_rate = failure_rate\\n        self.latency = latency\\n        self.requests = 0\\n        self.successes = 0\\n\\n    async def charge(self, amount: float, currency: str = \\\"USD\\\") -> dict:\\n        await asyncio.sleep(random.uniform(0.05, self.latency))\\n        self.requests += 1\\n        if random.random() < self.failure_rate:\\n            raise ConnectionError(\\\"upstream gateway timeout (simulated)\\\")\\n        self.successes += 1\\n        return {\\\"status\\\": \\\"ok\\\", \\\"amount\\\": amount, \\\"currency\\\": currency}\\n\\n\\n# --------------------------------------------------------------------------- #\\n# 2) الطريقة الأولى: التجميع اليدوي (CircuitBreaker + RetryPolicy)\\n# --------------------------------------------------------------------------- #\\nasync def call_with_manual_composition(gateway: FakePaymentGateway) -> None:\\n    print(\\\"=\\\" * 64)\\n    print(\\\"السيناريو (أ): تجميع يدوي — Breaker + RetryPolicy معاً\\\")\\n    print(\\\"=\\\" * 64)\\n\\n    breaker = CircuitBreaker(\\n        name=\\\"gateway-manual\\\",\\n        failure_threshold=3,       # ينفتح الدائرة بعد 3 إخفاقات متتالية\\n        recovery_timeout=2.0,      # ينتظر ثانيتين قبل السماح بمحاولة تجريبية\\n        half_open_max_calls=2,     # محاولتان تجريبيتان فقط في حالة HALF_OPEN\\n    )\\n    policy = RetryPolicy(\\n        max_attempts=5,            # 5 محاولات كحد أقصى\\n        base_delay=0.1,\\n        multiplier=2.0,\\n        max_delay=1.0,\\n        jitter=0.2,\\n    )\\n\\n    breaker.on_state_change(\\n        lambda old, new: print(f\\\"   ⚡ تغيّرت حالة الدائرة: {old} -> {new}\\\")\\n    )\\n\\n    attempts = 0\\n    while attempts < 12:\\n        attempts += 1\\n        try:\\n            result = await policy_retry_breaker(gateway, breaker, policy)\\n            print(f\\\"   ✓ محاولة #{attempts}: نجحت -> {result}\\\")\\n        except CircuitOpenError:\\n            print(f\\\"   ✗ محاولة #{attempts}: CircuitOpenError (fail-fast، لا نلمس الخدمة!)\\\")\\n        except RetryExhaustedError as exc:\\n            print(f\\\"   ✗ محاولة #{attempts}: RetryExhaustedError — آخر خطأ: {exc.last_exc!r}\\\")\\n        print(f\\\"      [state={breaker.state.value}, failures={breaker.failure_count}]\\\")\\n        await asyncio.sleep(0.3)\\n\\n\\nasync def policy_retry_breaker(\\n    gateway: FakePaymentGateway,\\n    breaker: CircuitBreaker,\\n    policy: RetryPolicy,\\n) -> dict:\\n    \\\"\\\"\\\"محاولة واحدة = محاولات Retry تمر كلها عبر الـ Breaker.\\\"\\\"\\\"\\n    attempts = 0\\n    while True:\\n        try:\\n            return await breaker.call(gateway.charge, 99.5, currency=\\\"USD\\\")\\n        except CircuitOpenError:\\n            raise  # الدائرة مفتوحة -> لا نعيد المحاولة، نفشل فوراً\\n        except Exception as exc:\\n            attempts += 1\\n            if attempts >= policy.max_attempts:\\n                raise RetryExhaustedError(attempts, exc) from exc\\n            await policy.sleep(attempts)\\n\\n\\n# --------------------------------------------------------------------------- #\\n# 3) الطريقة الثانية: الديكور الموحّد @resilient (Breaker + Retry + Timeout)\\n# --------------------------------------------------------------------------- #\\n@resilient(\\n    name=\\\"checkout\\\",\\n    failure_threshold=2,\\n    recovery_timeout=1.5,\\n    half_open_max_calls=1,\\n    max_attempts=4,\\n    base_delay=0.1,\\n    multiplier=2.0,\\n    max_delay=0.8,\\n    jitter=0.1,\\n    timeout=1.0,\\n)\\nasync def checkout(gateway: FakePaymentGateway, amount: float) -> dict:\\n    \\\"\\\"\\\"دفع الطلب — محمي بالكامل: breaker + retry + timeout.\\\"\\\"\\\"\\n    return await gateway.charge(amount)\\n\\n\\nasync def call_with_resilient_decorator(gateway: FakePaymentGateway) -> None:\\n    print()\\n    print(\\\"=\\\" * 64)\\n    print(\\\"السيناريو (ب): الديكور @resilient — Breaker + Retry + Timeout\\\")\\n    print(\\\"=\\\" * 64)\\n\\n    # نلحق callback لتتبع تغيّر الحالة\\n    async def watch(old, new):\\n        print(f\\\"   ⚡ [checkout] الدائرة: {old.value} -> {new.value}\\\")\\n\\n    # الديكور يفضح الكائن الداخلي عبر fn.resilient\\n    checkout.resilient.breaker.on_state_change(lambda o, n: None)  # placeholder\\n    # نستخدم بديلاً متزامناً بسيطاً للتتبع:\\n    def sync_watch(old, new):\\n        print(f\\\"   ⚡ [checkout] الدائرة: {old.value} -> {new.value}\\\")\\n    checkout.resilient.breaker.on_state_change(sync_watch)\\n\\n    for i in range(8):\\n        try:\\n            result = await checkout(gateway, 199.0)\\n            print(f\\\"   ✓ عملية #{i + 1}: نجحت -> {result}\\\")\\n        except CircuitOpenError:\\n            print(f\\\"   ✗ عملية #{i + 1}: CircuitOpenError — عرض رسالة 'الخدمة غير متاحة مؤقتاً'\\\")\\n        except RetryExhaustedError as exc:\\n            print(f\\\"   ✗ عملية #{i + 1}: استنفدت المحاولات — {exc.last_exc!r}\\\")\\n        except TimeoutError:\\n            print(f\\\"   ✗ عملية #{i + 1}: انتهت المهلة الزمنية\\\")\\n        print(f\\\"      [state={checkout.resilient.breaker.state.value}, \\\"\\n              f\\\"failures={checkout.resilient.breaker.failure_count}]\\\")\\n        await asyncio.sleep(0.25)\\n\\n\\n# --------------------------------------------------------------------------- #\\n# 4) محاكاة تدفق متزامن (burst) لإظهار الحماية تحت الضغط\\n# --------------------------------------------------------------------------- #\\nasync def concurrent_burst(gateway: FakePaymentGateway) -> None:\\n    print()\\n    print(\\\"=\\\" * 64)\\n    print(\\\"السيناريو (ج): 20 طلباً متزامناً نحو خدمة معطّلة تماماً\\\")\\n    print(\\\"=\\\" * 64)\\n\\n    breaker = CircuitBreaker(\\n        name=\\\"burst\\\",\\n        failure_threshold=3,\\n        recovery_timeout=0.5,\\n        half_open_max_calls=1,\\n    )\\n\\n    async def task(i: int) -> str:\\n        try:\\n            await breaker.call(gateway.charge, float(i))\\n            return f\\\"task-{i}: ok\\\"\\n        except CircuitOpenError:\\n            return f\\\"task-{i}: REJECTED (fail-fast)\\\"\\n        except Exception:\\n            return f\\\"task-{i}: failed\\\"\\n\\n    results = await asyncio.gather(*(task(i) for i in range(20)))\\n    ok = sum(1 for r in results if r.endswith(\\\"ok\\\"))\\n    rejected = sum(1 for r in results if \\\"REJECTED\\\" in r)\\n    failed = sum(1 for r in results if r.endswith(\\\"failed\\\"))\\n    print(f\\\"   النتائج: {ok} نجحت | {failed} فشلت | {rejected} رُفضت فوراً (fail-fast)\\\")\\n    print(f\\\"   إحصائيات الـ Breaker: {breaker.stats()}\\\")\\n\\n\\nasync def main() -> None:\\n    random.seed(42)  # نتائج قابلة للتكرار\\n    gateway = FakePaymentGateway(failure_rate=0.55, latency=0.25)\\n\\n    await call_with_manual_composition(gateway)\\n    await call_with_resilient_decorator(gateway)\\n    await concurrent_burst(gateway)\\n\\n    print()\\n    print(\\\"الإحصائيات النهائية للبوابة:\\\")\\n    print(f\\\"   إجمالي الطلبات التي وصلت للبوابة: {gateway.requests}\\\")\\n    print(f\\\"   الناجحة منها: {gateway.successes}\\\")\\n    print(\\\"   (لاحظ أن fail-fast منع جزءاً كبيراً من الطلبات من الوصول للبوابة أصلاً)\\\")\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    asyncio.run(main())\\n\", \"file_path\": \"/home/daytona/asyncio_circuit_breaker/examples/demo.py\"}, \"id\": \"call_00_Ab1vTawGxKRtZmlhl6Em9380\", \"type\": \"tool_call\"}, \"time\": \"2026-08-25 02:47:03 UTC\"}\n\ndata: {\"type\": \"tool_call_result\", \"data\": {\"name\": \"write_file\", \"content\": \"Updated file /home/daytona/asyncio_circuit_breaker/examples/demo.py\", \"id\": \"ab670972-6f8f-48f2-bab9-d1dda9b77de2\", \"tool_call_id\": \"call_00_Ab1vTawGxKRtZmlhl6Em9380\"}, \"time\": \"2026-08-25 02:47:06 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \"Wait\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \",\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" I\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" left\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" some\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" junk\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" in\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" the\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" demo\", \"time\": \"2026-08-25 02:47:07 UTC\"}\n\ndata: {\"type\": \"reasoning\", \"reasoning\": \" -\", \"time\": \"2026-08-25 02