ome/daytona/asyncio_circuit_breaker/tests/__init__.py\"},\"startedAt\":\"2026-08-25T02:48:02.000Z\",\"endedAt\":\"2026-08-25T02:48:02.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_01_OYyBTGlbveoe772Be1TC0506\",\"name\":\"write_file\",\"content\":\"Updated file /home/daytona/asyncio_circuit_breaker/pyproject.toml\"},\"startedAt\":\"2026-08-25T02:48:02.000Z\",\"endedAt\":\"2026-08-25T02:48:02.000Z\"},{\"type\":\"credit_usage\",\"content\":7,\"startedAt\":\"2026-08-25T02:48:04.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_00_ET_hkGEExTBVweWJw6ppcoV2595\",\"name\":\"execute\",\"args\":{\"command\":\"cd /home/daytona/asyncio_circuit_breaker && python3 -m pytest -q 2>&1 | tail -30\",\"timeout\":120,\"__result\":\"        \\\"\\\"\\\"\\n        effective = policy if policy is not None else RetryPolicy()\\n        last_exc: Optional[BaseException] = None\\n    \\n        for attempt in range(1, effective.max_attempts + 1):\\n            try:\\n                return await func(*args, **kwargs)\\n            except effective.retry_on as exc:\\n                last_exc = exc\\n                if attempt == effective.max_attempts:\\n                    break\\n                delay = effective.delay_for(attempt)\\n                logger.info(\\n                    \\\"Attempt %d/%d failed (%r); retrying in %.3fs\\\",\\n                    attempt, effective.max_attempts, exc, delay,\\n                )\\n                if on_retry is not None:\\n                    on_retry(attempt, exc, delay)\\n                await asyncio.sleep(delay)\\n    \\n        # Defensive: if last_exc is None the loop cannot have failed all attempts.\\n        assert last_exc is not None\\n>       raise RetryExhaustedError(effective.max_attempts, last_exc) from last_exc\\nE       circuit_breaker.retry.RetryExhaustedError: All 5 attempts failed. Last error: ValueError('fatal, no retry')\\n\\ncircuit_breaker/retry.py:125: RetryExhaustedError\\n=========================== short test summary info ============================\\nFAILED tests/test_circuit_breaker.py::test_half_open_limits_concurrent_trials\\nFAILED tests/test_retry.py::test_non_retryable_exception_propagates_immediately\\n2 failed, 28 passed in 0.68s\\n\\n[Command succeeded with exit code 0]\"},\"result\":\"        \\\"\\\"\\\"\\n        effective = policy if policy is not None else RetryPolicy()\\n        last_exc: Optional[BaseException] = None\\n    \\n        for attempt in range(1, effective.max_attempts + 1):\\n            try:\\n                return await func(*args, **kwargs)\\n            except effective.retry_on as exc:\\n                last_exc = exc\\n                if attempt == effective.max_attempts:\\n                    break\\n                delay = effective.delay_for(attempt)\\n                logger.info(\\n                    \\\"Attempt %d/%d failed (%r); retrying in %.3fs\\\",\\n                    attempt, effective.max_attempts, exc, delay,\\n                )\\n                if on_retry is not None:\\n                    on_retry(attempt, exc, delay)\\n                await asyncio.sleep(delay)\\n    \\n        # Defensive: if last_exc is None the loop cannot have failed all attempts.\\n        assert last_exc is not None\\n>       raise RetryExhaustedError(effective.max_attempts, last_exc) from last_exc\\nE       circuit_breaker.retry.RetryExhaustedError: All 5 attempts failed. Last error: ValueError('fatal, no retry')\\n\\ncircuit_breaker/retry.py:125: RetryExhaustedError\\n=========================== short test summary info ============================\\nFAILED tests/test_circuit_breaker.py::test_half_open_limits_concurrent_trials\\nFAILED tests/test_retry.py::test_non_retryable_exception_propagates_immediately\\n2 failed, 28 passed in 0.68s\\n\\n[Command succeeded with exit code 0]\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:48:04.000Z\",\"endedAt\":\"2026-08-25T02:48:08.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_00_ET_hkGEExTBVweWJw6ppcoV2595\",\"name\":\"execute\",\"content\":\"        \\\"\\\"\\\"\\n        effective = policy if policy is not None else RetryPolicy()\\n        last_exc: Optional[BaseException] = None\\n    \\n        for attempt in range(1, effective.max_attempts + 1):\\n            try:\\n                return await func(*args, **kwargs)\\n            except effective.retry_on as exc:\\n                last_exc = exc\\n                if attempt == effective.max_attempts:\\n                    break\\n                delay = effective.delay_for(attempt)\\n                logger.info(\\n                    \\\"Attempt %d/%d failed (%r); retrying in %.3fs\\\",\\n                    attempt, effective.max_attempts, exc, delay,\\n                )\\n                if on_retry is not None:\\n                    on_retry(attempt, exc, delay)\\n                await asyncio.sleep(delay)\\n    \\n        # Defensive: if last_exc is None the loop cannot have failed all attempts.\\n        assert last_exc is not None\\n>       raise RetryExhaustedError(effective.max_attempts, last_exc) from last_exc\\nE       circuit_breaker.retry.RetryExhaustedError: All 5 attempts failed. Last error: ValueError('fatal, no retry')\\n\\ncircuit_breaker/retry.py:125: RetryExhaustedError\\n=========================== short test summary info ============================\\nFAILED tests/test_circuit_breaker.py::test_half_open_limits_concurrent_trials\\nFAILED tests/test_retry.py::test_non_retryable_exception_propagates_immediately\\n2 failed, 28 passed in 0.68s\\n\\n[Command succeeded with exit code 0]\"},\"startedAt\":\"2026-08-25T02:48:08.000Z\",\"endedAt\":\"2026-08-25T02:48:08.000Z\"},{\"type\":\"reasoning\",\"content\":\"Two test failures:\\n\\n1. `test_non_retryable_exception_propagates_immediately`: ValueError is a subclass of Exception, and the default `retry_on=(Exception,)`. So ValueError IS retryable by default! My test is wrong — ValueError is caught by `except effective.retry_on` (Exception). To make it non-retryable, I need to pass `retry_on=(ConnectionError,)`. Let me fix the test.\\n\\n2. `test_half_open_limits_concurrent_trials`: Let me look at the failure. The issue: after `time.sleep(0.1)`, then `two_concurrent_calls`. Inside, `dep.set_mode(\\\"ok\\\")`. Then t1 = slow_call, wait started, then `await breaker.call(dep.call)` should raise CircuitOpenError.\\n\\nHmm, but the error might be that `started.set()` happens inside slow_call before breaker.call is invoked, and then main awaits started — but t1 might not have reached `breaker.call` yet when main tries `breaker.call`. There's a race: t1 sets `started` then `await asyncio.sleep(0.2)` then calls breaker.call. Main waits for started, then calls breaker.call immediately — but t1 is still sleeping (0.2s), hasn't taken the HALF_OPEN slot yet. So main's call transitions to HALF_OPEN and takes the slot, succeeds... then t1's call comes after 0.2s and fails/gets rejected? Actually after main's call succeeds, state is CLOSED. Then t1 calls breaker.call -> state CLOSED -> allowed, calls dep.call -> returns \\\"ok\\\", calls=2. So dep.calls == 2, not 1. And `with pytest.raises(CircuitOpenError)` fails because no exception raised. That's the race.\\n\\nI need to restructure so the first call actually occupies the HALF_OPEN slot before the second call arrives. Let me use an event that is set *after* the breaker call begins but before it finishes. Better approach: make the first call hold the slot using an event inside the dependency call:\\n\\n```python\\nasync def two_concurrent_calls():\\n    entered = asyncio.Event()\\n    release = asyncio.Event()\\n\\n    async def holding_call():\\n        entered.set()\\n        await release.wait()\\n        return await breaker.call(dep.call)\\n\\n    t1 = asyncio.create_task(holding_call())\\n    await entered.wait()\\n    # now t1 is waiting; but it hasn't called breaker.call yet...\\n```\\n\\nHmm same race. The slot is taken inside `breaker.call`, not before. I need to know when the breaker call has acquired the slot. Options:\\n- Set the event inside the dependency function itself:\\n\\n```python\\ndep.set_mode(\\\"ok\\\") — but we need the dep call to signal when it starts.\\n\\nActually easier: create a custom async func that signals when it starts:\\n\\nentered = asyncio.Event()\\nasync def first():\\n    entered.set()\\n    await asyncio.sleep(0.2)\\n    return await breaker.call(dep.call)\\n```\\n\\nThe problem: after `entered.set()`, there's `await asyncio.sleep(0.2)` before breaker.call. So main wakes at `entered` while t1 is still sleeping. Same race.\\n\\nSolution: set the event at the very start of the func, and make the func's body enter breaker.call immediately without an intermediate await:\\n\\n```python\\nasync def first():\\n    entered.set()\\n    return await breaker.call(dep.call)  # dep.call is slow itself\\n```\\n\\nBut `entered.set()` followed directly by `return await breaker.call(...)` — after `entered.set()`, the coroutine yields control at the first await point, which is `breaker.call`. So main's `await entered.wait()` may resume BEFORE t1 even starts running breaker.call. Race persists: main might call breaker.call first.\\n\\nReliable approach: have the first call go through breaker and into the dependency (which blocks), signaling once the slot is taken:\\n\\n```python\\ninside = asyncio.Event()\\n\\nasync def dep_slow():\\n    inside.set()\\n    await asyncio.sleep(0.2)\\n    return \\\"ok\\\"\\n\\nasync def scenario():\\n    t1 = asyncio.create_task(breaker.call(dep_slow))\\n    await inside.wait()\\n    # الآن t1 يحمل فتحة HALF_OPEN وبداخله dep_slow\\n    with pytest.raises(CircuitOpenError):\\n        await breaker.call(dep.call)\\n    result = await t1\\n    return result\\n```\\n\\nBut `dep_slow` — when is `inside.set()` executed relative to breaker.call? breaker.call calls `await func(*args)` which starts dep_slow; dep_slow runs until first await — sets inside, then `await asyncio.sleep(0.2)` yields. So when `inside` is set, t1 is inside breaker.call with slot acquired. Main wakes, calls breaker.call -> HALF_OPEN, half_open_used=1 >= 1 -> CircuitOpenError.\\n\\nBut subtlety: when dep_slow returns \\\"ok\\\", `_record_success` transitions HALF_OPEN -> CLOSED, failure_count=0. dep.calls — hmm dep_slow is not dep.call; dep.calls remains 0 because we never used dep.call for the first call. Let me count manually instead. Let me rewrite the test to track a counter.\\n\\nActually let me make the dependency the FakeDependency but with a custom mode where it signals. Simpler to just write a custom async function:\\n\\n```python\\ndef test_half_open_limits_concurrent_trials():\\n    breaker = CircuitBreaker(failure_threshold=1, recovery_timeout=0.05, half_open_max_calls=1)\\n    dep = FakeDependency()\\n    dep.set_mode(\\\"fail\\\")\\n\\n    with pytest.raises(ConnectionError):\\n        run(lambda: breaker.call(dep.call))\\n    assert breaker.state is CircuitState.OPEN\\n\\n    time.sleep(0.1)\\n\\n    inside = asyncio.Event()\\n   \",\"startedAt\":\"2026-08-25T02:48:09.000Z\",\"endedAt\":null,\"thinkingSeconds\":6}],\"isStreaming\":true,\"isInterrupted\":false,\"generatedFiles\":[],\"conversation_id\":\"1d5a566a-aea8-49f8-9e7a-1d24a5b22643\",\"created_at\":1787626003418,\"fileInfo\":null,\"fileInfos\":null,\"modelValue\":\"deepseek-v4-flash\",\"isAutoModel\":false,\"isStopped\":false,\"creditsUsed\":7}]}}"
          }
