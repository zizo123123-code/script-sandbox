_breaker/circuit_breaker/retry.py\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/2a9f0ae207504868824f7d8b0c3bec07.py\\\"}, \\\"/home/daytona/asyncio_circuit_breaker/circuit_breaker/protected.py\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/d5f63cfedd2444789a780e4b89c0085d.py\\\"}, \\\"/home/daytona/asyncio_circuit_breaker/examples/demo.py\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/b645020218f74a48af2bba5cb8cf539c.py\\\"}, \\\"/home/daytona/asyncio_circuit_breaker/tests/conftest.py\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/0ea79b5bf25a48268e875d88bfbeb3b3.py\\\"}, \\\"/home/daytona/asyncio_circuit_breaker/tests/test_circuit_breaker.py\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/6f0a62ac80b54f8684d9e2431445c06f.py\\\"}, \\\"/home/daytona/asyncio_circuit_breaker/tests/test_retry.py\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/c9e3bb707627425b97ea51101b033913.py\\\"}, \\\"/home/daytona/asyncio_circuit_breaker/tests/test_protected.py\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/2ebdb2872c4e4c0eba886dabdbdea6e0.py\\\"}, \\\"/home/daytona/asyncio_circuit_breaker/pyproject.toml\\\": {\\\"url\\\": \\\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/a81852e5acde4545b2c500cb1f286a24.toml\\\"}}\"},\"startedAt\":\"2026-08-25T02:49:34.000Z\",\"endedAt\":\"2026-08-25T02:49:34.000Z\"},{\"type\":\"credit_usage\",\"content\":14,\"startedAt\":\"2026-08-25T02:49:37.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_00_ET_50IZlhSXfOm5T0m0xJF36785\",\"name\":\"write_todos\",\"args\":{\"todos\":[{\"content\":\"إنشاء هيكل المشروع وكتابة النواة: CircuitBreaker (circuit_breaker.py)\",\"status\":\"completed\"},{\"content\":\"كتابة سياسة Retry مع Exponential Backoff (retry.py)\",\"status\":\"completed\"},{\"content\":\"كتابة طبقة الدمج ResilientCaller والديكورات (protected.py) + ملفات الدعم\",\"status\":\"completed\"},{\"content\":\"كتابة مثال توضيحي تشغيلي (examples/demo.py)\",\"status\":\"completed\"},{\"content\":\"كتابة اختبارات وحدة شاملة (tests/)\",\"status\":\"completed\"},{\"content\":\"تشغيل الاختبارات والمثال والتحقق من سلامة الكود\",\"status\":\"completed\"},{\"content\":\"كتابة README بالعربية ورفع جميع الملفات\",\"status\":\"completed\"}],\"__result\":\"Updated todo list to [{'content': 'إنشاء هيكل المشروع وكتابة النواة: CircuitBreaker (circuit_breaker.py)', 'status': 'completed'}, {'content': 'كتابة سياسة Retry مع Exponential Backoff (retry.py)', 'status': 'completed'}, {'content': 'كتابة طبقة الدمج ResilientCaller والديكورات (protected.py) + ملفات الدعم', 'status': 'completed'}, {'content': 'كتابة مثال توضيحي تشغيلي (examples/demo.py)', 'status': 'completed'}, {'content': 'كتابة اختبارات وحدة شاملة (tests/)', 'status': 'completed'}, {'content': 'تشغيل الاختبارات والمثال والتحقق من سلامة الكود', 'status': 'completed'}, {'content': 'كتابة README بالعربية ورفع جميع الملفات', 'status': 'completed'}]\"},\"result\":\"Updated todo list to [{'content': 'إنشاء هيكل المشروع وكتابة النواة: CircuitBreaker (circuit_breaker.py)', 'status': 'completed'}, {'content': 'كتابة سياسة Retry مع Exponential Backoff (retry.py)', 'status': 'completed'}, {'content': 'كتابة طبقة الدمج ResilientCaller والديكورات (protected.py) + ملفات الدعم', 'status': 'completed'}, {'content': 'كتابة مثال توضيحي تشغيلي (examples/demo.py)', 'status': 'completed'}, {'content': 'كتابة اختبارات وحدة شاملة (tests/)', 'status': 'completed'}, {'content': 'تشغيل الاختبارات والمثال والتحقق من سلامة الكود', 'status': 'completed'}, {'content': 'كتابة README بالعربية ورفع جميع الملفات', 'status': 'completed'}]\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:49:37.000Z\",\"endedAt\":\"2026-08-25T02:49:37.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_00_ET_50IZlhSXfOm5T0m0xJF36785\",\"name\":\"write_todos\",\"content\":\"Updated todo list to [{'content': 'إنشاء هيكل المشروع وكتابة النواة: CircuitBreaker (circuit_breaker.py)', 'status': 'completed'}, {'content': 'كتابة سياسة Retry مع Exponential Backoff (retry.py)', 'status': 'completed'}, {'content': 'كتابة طبقة الدمج ResilientCaller والديكورات (protected.py) + ملفات الدعم', 'status': 'completed'}, {'content': 'كتابة مثال توضيحي تشغيلي (examples/demo.py)', 'status': 'completed'}, {'content': 'كتابة اختبارات وحدة شاملة (tests/)', 'status': 'completed'}, {'content': 'تشغيل الاختبارات والمثال والتحقق من سلامة الكود', 'status': 'completed'}, {'content': 'كتابة README بالعربية ورفع جميع الملفات', 'status': 'completed'}]\"},\"startedAt\":\"2026-08-25T02:49:37.000Z\",\"endedAt\":\"2026-08-25T02:49:37.000Z\"},{\"type\":\"text\",\"content\":\"تم بناء المشروع كاملاً واجتاز **30/30 اختباراً** بنجاح ✅\\n\\n## 📦 ما تم تسليمه — مشروع `asyncio_circuit_breaker`\\n\\n### 🧩 بنية المعمارية (ثلاث طبقات مرنة)\\n\\n```\\nالطلب ← [الدائرة مفتوحة؟] → fail-fast (CircuitOpenError)\\n        ↓  مغلقة\\n   [نفّذ المحاولة] → فشل → [سجّل على الدائرة] → [أعد المحاولة بتأخير أُسّي + jitter]\\n        ↓ نجحت                          ↓\\n   أعد النتيجة              استنفدت المحاولات → RetryExhaustedError\\n```\\n\\n### 📄 الملفات\\n\\n| الملف | المحتوى |\\n|---|---|\\n| [README.md](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/83f3a6c5b2344a0bb2125b1800749d56.md) | توثيق شامل بالعربية: معادلات، مخططات الحالات، أمثلة، إرشادات التشغيل |\\n| [circuit_breaker.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/5ed32551020649968865438733f74fc8.py) | **النواة**: `CircuitBreaker` بآلة حالات CLOSED/OPEN/HALF_OPEN، قفل `asyncio.Lock` للسلامة التزامنية، عدّادات، callback لتغيّر الحالة + ديكور `@circuit` |\\n| [retry.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/2a9f0ae207504868824f7d8b0c3bec07.py) | **الـ Retry**: `RetryPolicy` بصيغة `delay(N)=min(base×mult^(N-1), max)` مع **جitter عشوائي** لمنع Thundering Herd + ديكور `@retryable` |\\n| [protected.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/d5f63cfedd2444789a780e4b89c0085d.py) | **الدمج**: `ResilientCaller` (Breaker + Retry + مهلة زمنية `asyncio.wait_for`) + ديكور موحّد `@resilient` |\\n| [demo.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/b645020218f74a48af2bba5cb8cf539c.py) | مثال حي: محاكاة بوابة دفع غير مستقرة بـ 3 سيناريوهات (تجميع يدوي، ديكور، 20 طلباً متزامناً) |\\n| [test_circuit_breaker.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/6f0a62ac80b54f8684d9e2431445c06f.py) · [test_retry.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/c9e3bb707627425b97ea51101b033913.py) · [test_protected.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/2ebdb2872c4e4c0eba886dabdbdea6e0.py) | 30 اختبار وحدة: انتقالات الحالات، fail-fast، حدود HALF_OPEN المتزامنة، المعادلة الأُسّية والسقف، التزامن تحت الضغط |\\n| [__init__.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/6f73524a25bc437da8f56f042499c372.py) · [conftest.py](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/0ea79b5bf25a48268e875d88bfbeb3b3.py) · [pyproject.toml](https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/a81852e5acde4545b2c500cb1f286a24.toml) | الواجهة العامة + مرافق الاختبارات + إعدادات الحزمة |\\n\\n### 🚀 أبرز نقاط التصميم\\n\\n- **Fail-fast حقيقي**: عندما تنفتح الدائرة تُرفض الطلبات فوراً **دون لمس الخدمة** (أثبت المثال أن الخادم تلقّى 38 طلباً فقط بينما أُرسل أكثر من 60، بفضل الرفض المبكر).\\n- **حلقة Retry خارج الدائرة**: كل محاولة تمر عبر الدائرة؛ فإذا انفتحت أثناء المحاولات، يتوقف الـ Retry فوراً بدل إهدار المحاولات المتبقية (مُختبَر في `test_breaker_trips_during_retries_then_fails_fast`).\\n- **سلامة تزامنية**: كل تحوّلات الحالة تحت `asyncio.Lock`، لذا يمكن مشاركة نفس الـ Breaker بين مئات الـ coroutines.\\n- **قابلية التخصيص**: `retry_on` لأنواع استثناءات محددة، مهلة زمنية اختيارية، ومراقبة عبر `stats()` و`on_state_change`.\\n\\n### ▶️ التشغيل\\n\\n```bash\\npython3 -m pytest -q    # 30 passed\\npython3 examples/demo.py\\n```\\n\\nالمتطلبات: Python ≥ 3.9 فقط — **بدون أي تبعيات خارجية**. إذا أردت المشروع كملف ZIP واحد أو بصيغة أخرى (docx/pdf للتوثيق)، أخبرني وسأجهزه لك.\",\"startedAt\":\"2026-08-25T02:49:38.000Z\",\"endedAt\":\"2026-08-25T02:49:47.000Z\"},{\"type\":\"credit_usage\",\"content\":14,\"startedAt\":\"2026-08-25T02:49:47.000Z\"},{\"type\":\"credit_usage\",\"content\":14,\"startedAt\":\"2026-08-25T02:49:47.000Z\"}],\"isStreaming\":false,\"isInterrupted\":false,\"generatedFiles\":[{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/83f3a6c5b2344a0bb2125b1800749d56.md\",\"name\":\"README.md\",\"ext\":\"md\",\"kind\":\"markdown\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/5ed32551020649968865438733f74fc8.py\",\"name\":\"circuit_breaker.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/2a9f0ae207504868824f7d8b0c3bec07.py\",\"name\":\"retry.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/d5f63cfedd2444789a780e4b89c0085d.py\",\"name\":\"protected.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/b645020218f74a48af2bba5cb8cf539c.py\",\"name\":\"demo.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/6f0a62ac80b54f8684d9e2431445c06f.py\",\"name\":\"test_circuit_breaker.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/c9e3bb707627425b97ea51101b033913.py\",\"name\":\"test_retry.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/2ebdb2872c4e4c0eba886dabdbdea6e0.py\",\"name\":\"test_protected.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/6f73524a25bc437da8f56f042499c372.py\",\"name\":\"__init__.py\",\"ext\":\"py\",\"kind\":\"code\"},{\"url\":\"https://cdn.ng-resource.com/product/resource/notegpt/files/2026/08/24/0ea79b5bf25a48268e875d88bfbeb3b3.py\",\"name\":\"conftest.py\",\"ext\":\"py\",\"kind\":\"code\"}],\"conversation_id\":\"1d5a566a-aea8-49f8-9e7a-1d24a5b22643\",\"created_at\":1787626003418,\"fileInfo\":null,\"fileInfos\":null,\"modelValue\":\"deepseek-v4-flash\",\"isAutoModel\":false,\"isStopped\":false,\"creditsUsed\":14}]}}"
