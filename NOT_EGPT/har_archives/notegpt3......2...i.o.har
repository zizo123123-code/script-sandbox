mand succeeded with exit code 0]\"},\"startedAt\":\"2026-08-25T02:45:05.000Z\",\"endedAt\":\"2026-08-25T02:45:05.000Z\"},{\"type\":\"reasoning\",\"content\":\"Python 3.14.4. Good. Now let me create the project structure:\\n\\n```\\n/home/daytona/asyncio_circuit_breaker/\\n├── circuit_breaker/          # الحزمة\\n│   ├── __init__.py\\n│   ├── circuit_breaker.py\\n│   ├── retry.py\\n│   └── protected.py\\n├── examples/\\n│   └── demo.py\\n├── tests/\\n│   └── test_circuit_breaker.py\\n│   └── test_retry.py\\n│   └── test_protected.py\\n├── README.md\\n└── requirements.txt\\n```\\n\\nLet me write the files now.\",\"startedAt\":\"2026-08-25T02:45:06.000Z\",\"endedAt\":\"2026-08-25T02:45:07.000Z\",\"thinkingSeconds\":1,\"stepId\":\"step-0\"},{\"type\":\"text\",\"content\":\"ممتاز. سأبني المشروع الآن في مجلد جديد نظيف. أبدأ بكتابة نواة الـ Circuit Breaker:\",\"startedAt\":\"2026-08-25T02:45:07.000Z\",\"stepId\":\"step-0\",\"endedAt\":\"2026-08-25T02:45:07.000Z\"},{\"type\":\"reasoning\",\"content\":\"{\\\"file_path\\\": \\\"/home/daytona/asyncio_circuit_breaker/circuit_breaker/__init__.py\\\", \\\"content\\\": \\\"\\\\\\\"\\\\\\\"\\\\\\\"حزمة Circuit Breaker + Retry (Exponential Backoff) مبنية على asyncio.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nfrom .circuit_breaker import CircuitBreaker, CircuitOpenError, CircuitState, circuit\\\\nfrom .retry import RetryExhaustedError, RetryPolicy, retry, retryable\\\\nfrom .protected import ResilientCaller, resilient\\\\n\\\\n__all__ = [\\\\n    \\\\\\\"CircuitBreaker\\\\\\\",\\\\n    \\\\\\\"CircuitOpenError\\\\\\\",\\\\n    \\\\\\\"CircuitState\\\\\\\",\\\\n    \\\\\\\"circuit\\\\\\\",\\\\n    \\\\\\\"RetryPolicy\\\\\\\",\\\\n    \\\\\\\"RetryExhaustedError\\\\\\\",\\\\n    \\\\\\\"retry\\\\\\\",\\\\n    \\\\\\\"retryable\\\\\\\",\\\\n    \\\\\\\"ResilientCaller\\\\\\\",\\\\n    \\\\\\\"resilient\\\\\\\",\\\\n]\\\\n\\\\n__version__ = \\\\\\\"1.0.0\\\\\\\"\\\\n\\\"}\",\"startedAt\":\"2026-08-25T02:45:07.000Z\",\"endedAt\":\"2026-08-25T02:45:08.000Z\",\"thinkingSeconds\":1,\"stepId\":\"step-0\"},{\"type\":\"credit_usage\",\"content\":6,\"startedAt\":\"2026-08-25T02:45:08.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_00_QNfDZDgC3MKSO1RNVJbR1274\",\"name\":\"write_file\",\"args\":{\"file_path\":\"/home/daytona/asyncio_circuit_breaker/circuit_breaker/__init__.py\",\"content\":\"\\\"\\\"\\\"حزمة Circuit Breaker + Retry (Exponential Backoff) مبنية على asyncio.\\\"\\\"\\\"\\n\\nfrom .circuit_breaker import CircuitBreaker, CircuitOpenError, CircuitState, circuit\\nfrom .retry import RetryExhaustedError, RetryPolicy, retry, retryable\\nfrom .protected import ResilientCaller, resilient\\n\\n__all__ = [\\n    \\\"CircuitBreaker\\\",\\n    \\\"CircuitOpenError\\\",\\n    \\\"CircuitState\\\",\\n    \\\"circuit\\\",\\n    \\\"RetryPolicy\\\",\\n    \\\"RetryExhaustedError\\\",\\n    \\\"retry\\\",\\n    \\\"retryable\\\",\\n    \\\"ResilientCaller\\\",\\n    \\\"resilient\\\",\\n]\\n\\n__version__ = \\\"1.0.0\\\"\\n\",\"__result\":\"Updated file /home/daytona/asyncio_circuit_breaker/circuit_breaker/__init__.py\"},\"result\":\"Updated file /home/daytona/asyncio_circuit_breaker/circuit_breaker/__init__.py\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:45:08.000Z\",\"stepId\":\"step-0\",\"endedAt\":\"2026-08-25T02:45:10.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"call_00_QNfDZDgC3MKSO1RNVJbR1274\",\"name\":\"write_file\",\"content\":\"Updated file /home/daytona/asyncio_circuit_breaker/circuit_breaker/__init__.py\"},\"startedAt\":\"2026-08-25T02:45:10.000Z\",\"endedAt\":\"2026-08-25T02:45:10.000Z\"},{\"type\":\"reasoning\",\"content\":\"{\\\"content\\\": \\\"\\\\\\\"\\\\\\\"\\\\\\\"\\\\nCircuit Breaker pattern implemented on top of asyncio.\\\\n\\\\nState machine\\\\n=============\\\\n\\\\n    failures >= failure_threshold\\\\n   ┌──────────┐ ─────────────────────────────▶ ┌──────────┐\\\\n   │  CLOSED  │                                │   OPEN   │\\\\n   └──────────┘ ◀───────────────────────────── └──────────┘\\\\n        ▲          trial call succeeds            │\\\\n        │                                          │ after recovery_timeout\\\\n        │                                          ▼\\\\n        │                              ┌─────────────────────┐\\\\n        └──────────────────────────────│      HALF_OPEN      │\\\\n                                       │  (limited trial)    │\\\\n                                       └─────────────────────┘\\\\n                                                │\\\\n                                          trial call fails\\\\n                                                ▼\\\\n                                         back to OPEN\\\\n\\\\nTransition rules\\\\n================\\\\n* CLOSED  -> OPEN      : `failure_threshold` consecutive failures recorded.\\\\n* OPEN    -> HALF_OPEN : `recovery_timeout` seconds elapsed since opening.\\\\n* HALF_OPEN            : allows at most `half_open_max_calls` concurrent trial calls.\\\\n* HALF_OPEN -> CLOSED  : any trial call succeeds -> dependency recovered.\\\\n* HALF_OPEN -> OPEN    : any trial call fails   -> dependency still broken.\\\\n\\\\nThread-safety\\\\n=============\\\\nAll internal state mutations happen inside `self._lock` (asyncio.Lock),\\\\nso the breaker is safe to share across many concurrent coroutines.\\\\n\\\\nUsage\\\\n=====\\\\n    breaker = CircuitBreaker(failure_threshold=3, recovery_timeout=5.0)\\\\n    try:\\\\n        result = await breaker.call(my_async_fn, *args, **kwargs)\\\\n    except CircuitOpenError:\\\\n        # fail fast - do not touch the dependency\\\\n        result = fallback()\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\nfrom __future__ import annotations\\\\n\\\\nimport asyncio\\\\nimport logging\\\\nimport time\\\\nfrom enum import Enum\\\\nfrom typing import Any, Awaitable, Callable, Optional, TypeVar\\\\n\\\\nlogger = logging.getLogger(__name__)\\\\n\\\\nT = TypeVar(\\\\\\\"T\\\\\\\")\\\\n\\\\n\\\\nclass CircuitState(Enum):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The three states of a circuit breaker.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    CLOSED = \\\\\\\"closed\\\\\\\"\\\\n    OPEN = \\\\\\\"open\\\\\\\"\\\\n    HALF_OPEN = \\\\\\\"half_open\\\\\\\"\\\\n\\\\n    def __str__(self) -> str:  # pragma: no cover - trivial\\\\n        return self.value\\\\n\\\\n\\\\nclass CircuitOpenError(Exception):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Raised when a call is rejected because the circuit is OPEN (fail-fast).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(self, message: str = \\\\\\\"Circuit is open; call rejected (fail-fast).\\\\\\\") -> None:\\\\n        super().__init__(message)\\\\n\\\\n\\\\nclass CircuitBreaker:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"An asyncio-aware circuit breaker guarding calls to a fragile dependency.\\\\n\\\\n    Parameters\\\\n    ----------\\\\n    name:\\\\n        Human-readable identifier used in logs / errors.\\\\n    failure_threshold:\\\\n        Consecutive failures inside CLOSED state that trip the breaker to OPEN.\\\\n    recovery_timeout:\\\\n        Seconds the breaker stays OPEN before allowing a trial (HALF_OPEN).\\\\n    half_open_max_calls:\\\\n        Maximum number of concurrent trial calls allowed while HALF_OPEN.\\\\n    exceptions:\\\\n        Tuple of exception types counted as \\\\\\\"failures\\\\\\\". Anything else is\\\\n        re-raised without affecting the breaker state.\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    def __init__(\\\\n        self,\\\\n        name: str = \\\\\\\"default\\\\\\\",\\\\n        failure_threshold: int = 5,\\\\n        recovery_timeout: float = 30.0,\\\\n        half_open_max_calls: int = 1,\\\\n        exceptions: tuple[type[BaseException], ...] = (Exception,),\\\\n    ) -> None:\\\\n        if failure_threshold <= 0:\\\\n            raise ValueError(\\\\\\\"failure_threshold must be > 0\\\\\\\")\\\\n        if recovery_timeout <= 0:\\\\n            raise ValueError(\\\\\\\"recovery_timeout must be > 0\\\\\\\")\\\\n        if half_open_max_calls <= 0:\\\\n            raise ValueError(\\\\\\\"half_open_max_calls must be > 0\\\\\\\")\\\\n\\\\n        self.name = name\\\\n        self.failure_threshold = failure_threshold\\\\n        self.recovery_timeout = recovery_timeout\\\\n        self.half_open_max_calls = half_open_max_calls\\\\n        self.exceptions = exceptions\\\\n\\\\n        # --- internal state (always guarded by self._lock) ---\\\\n        self._state = CircuitState.CLOSED\\\\n        self._failure_count = 0\\\\n        self._half_open_used = 0\\\\n        self._opened_at: Optional[float] = None\\\\n        self._lock = asyncio.Lock()\\\\n        self._on_state_change: Optional[Callable[[CircuitState, CircuitState], Any]] = None\\\\n\\\\n        # --- observability counters (approximate, not atomic under lock) ---\\\\n        self.total_calls = 0\\\\n        self.successful_calls = 0\\\\n        self.failed_calls = 0\\\\n        self.rejected_calls = 0\\\\n\\\\n    # ------------------------------------------------------------------ #\\\\n    # Public API\\\\n    # ------------------------------------------------------------------ #\\\\n    @property\\\\n    def state(self) -> CircuitState:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Current state of the breaker (CLOSED / OPEN / HALF_OPEN).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        return self._state\\\\n\\\\n    @property\\\\n    def failure_count(self) -> int:\\\\n        return self._failure_count\\\\n\\\\n    @property\\\\n    def is_open(self) -> bool:\\\\n        return self._state is CircuitState.OPEN\\\\n\\\\n    def on_state_change(\\\\n        self, callback: Callable[[CircuitState, CircuitState], Any]\\\\n    ) -> None:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Register a callback invoked as ``callback(old_state, new_state)``.\\\\n\\\\n        Useful for metrics (Prometheus), logging, or alerts. The callback must\\\\n        never raise: exceptions are caught and logged.\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n        self._on_state_change = callback\\\\n\\\\n    def stats(self) -> dict:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Return a snapshot of the internal counters.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        return {\\\\n            \\\\\\\"name\\\\\\\": self.name,\\\\n            \\\\\\\"state\\\\\\\": self._state.value,\\\\n            \\\\\\\"failure_count\\\\\\\": self._failure_count,\\\\n            \\\\\\\"total_calls\\\\\\\": self.total_calls,\\\\n            \\\\\\\"successful_calls\\\\\\\": self.successful_calls,\\\\n            \\\\\\\"failed_calls\\\\\\\": self.failed_calls,\\\\n            \\\\\\\"rejected_calls\\\\\\\": self.rejected_calls,\\\\n        }\\\\n\\\\n    async def call(self, func: Callable[..., Awaitable[T]], *args: Any, **kwargs: Any) -> T:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Execute ``func(*args, **kwargs)`` through the circuit breaker.\\\\n\\\\n        Raises\\\\n        ------\\\\n        CircuitOpenError\\\\n            If the breaker is OPEN (or HALF_OPEN with no trial slots left),\\\\n            the call is rejected without touching the dependency.\\\\n        func's exceptions\\\\n            Re-raised after the failure has been recorded by the breaker.\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"\\\\n        if not await self._try_acquire_permission():\\\\n            self.rejected_calls += 1\\\\n            raise CircuitOpenError(\\\\n                f\\\\\\\"[{self.name}] breaker is {self._state.value}; call rejected (fail-fast).\\\\\\\"\\\\n            )\\\\n\\\\n        self.total_calls += 1\\\\n        try:\\\\n            result = await func(*args, **kwargs)\\\\n        except self.exceptions as exc:\\\\n            self.failed_calls += 1\\\\n            await self._record_failure()\\\\n            raise\\\\n        else:\\\\n            self.successful_calls += 1\\\\n            await self._record_success()\\\\n            return result\\\\n\\\\n    # ------------------------------------------------------------------ #\\\\n    # Internals — all mutating methods run under self._lock\\\\n    # ------------------------------------------------------------------ #\\\\n    async def _try_acquire_permission(self) -> bool:\\\\n        \\\\\\\"\\\\\\\"\\\\\\\"Atomically decide whether a new call may enter the dependency.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n        async with self._lock:\\\\n            if self._state is CircuitState.CLOSED:\\\\n                return True\\\\n\\\\n            if self._state is CircuitState.OPEN:\\\\n                elapsed = time.monotonic() - (self._opened_at or 0.0)\\\\n                if elapsed >= self.recovery_timeout:\\\\n                    # Cooldown finished -> allow a limited number of trials.\\\\n                    self._transition(CircuitState.HALF_OPEN)\\\\n                    self._half_open_used = 0\\\\n                else:\\\\n                    return False\\\\n\\\\n            # HALF_OPEN: only `half_open_max_calls` trial calls may run.\\\\n            if self._half_open_used >= self.half_open_max_calls:\\\\n                return False\\\\n            self._half_open_used += 1\\\\n            return True\\\\n\\\\n    async def _record_success(self) -> None:\\\\n        async with self._lock:\\\\n            if self._state is CircuitState.HALF_OPEN:\\\\n                # A trial call succeeded -> the dependency has recovered.\\\\n                self._transition(CircuitState.CLOSED)\\\\n                self._half_open_used = 0\\\\n            # Reset the consecutive-failure counter on any success (CLOSED too).\\\\n            self._failure_count = 0\\\\n\\\\n    async def _record_failure(self) -> None:\\\\n        async with self._lock:\\\\n            self._failure_count += 1\\\\n            if self._state is CircuitState.HALF_OPEN:\\\\n                # A trial call failed -> still broken, trip it again.\\\\n                self._open_circuit()\\\\n            elif self._failure_count >= self.failure_threshold:\\\\n                self._open_circuit()\\\\n\\\\n    def _open_circuit(self) -> None:\\\\n        self._transition(CircuitState.OPEN)\\\\n        self._opened_at = time.monotonic()\\\\n\\\\n    def _transition(self, new_state: CircuitState) -> None:\\\\n        old = self._state\\\\n        if old is new_state:\\\\n            return\\\\n        self._state = new_state\\\\n        logger.info(\\\\\\\"Circuit [%s]: %s -> %s\\\\\\\", self.name, old.value, new_state.value)\\\\n        if self._on_state_change is not None:\\\\n            try:\\\\n                self._on_state_change(old, new_state)\\\\n            except Exception:  # pragma: no cover - defensive\\\\n                logger.exception(\\\\\\\"state-change callback failed\\\\\\\")\\\\n\\\\n\\\\ndef circuit(*cb_args: Any, **cb_kwargs: Any):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Decorator that wraps an async function with a CircuitBreaker.\\\\n\\\\n    Example\\\\n    -------\\\\n        @circuit(name=\\\\\\\"db\\\\\\\", failure_threshold=3, recovery_timeout=5.0)\\\\n        async def query(sql: str) -> list[dict]:\\\\n            ...\\\\n\\\\n        await query(\\\\\\\"SELECT 1\\\\\\\")            # normal call\\\\n        await query(\\\\\\\"SELECT 1\\\\\\\")            # raises CircuitOpenError if OPEN\\\\n        query.circuit_breaker.state        # inspect the breaker from outside\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n\\\\n    breaker = CircuitBreaker(*cb_args, **cb_kwargs)\\\\n\\\\n    def decorator(func: Callable[..., Awaitable[T]]) -> Callable[..., Awaitable[T]]:\\\\n        async def wrapper(*args: Any, **kwargs: Any) -> T:\\\\n            return await breaker.call(func, *args, **kwargs)\\\\n\\\\n        wrapper.circuit_breaker = breaker  # type: ignore[attr-defined]\\\\n        wrapper.__name__ = func.__name__\\\\n        wrapper.__doc__ = func.__doc__\\\\n        return wrapper\\\\n\\\\n    return decorator\\\\n\\\", \\\"file_path\\\": \\\"/home/daytona/asyncio_circuit_breaker/circuit_breaker/circuit_breaker.py\\\"}\",\"startedAt\":\"2026-08-25T02:45:11.000Z\",\"endedAt\":\"2026-08-25T02:45:24.000Z\",\"thinkingSeconds\":13,\"stepId\":\"step-0\"},{\"type\":\"credit_usage\",\"content\":7,\"startedAt\":\"2026-08-25T02:45:24.000Z\"},{\"type\":\"tool_call\",\"content\":{\"id\":\"call_00_ET_xHd1X8AQaAE302sDzhIP6997\",\"name\":\"write_file\",\"args\":{\"content\":\"\\\"\\\"\\\"\\nCircuit Breaker pattern implemented on top of asyncio.\\n\\nState machine\\n=============\\n\\n    failures >= failure_threshold\\n   ┌──────────┐ ─────────────────────────────▶ ┌──────────┐\\n   │  CLOSED  │                                │   OPEN   │\\n   └──────────┘ ◀───────────────────────────── └──────────┘\\n        ▲          trial call succeeds            │\\n        │                                          │ after recovery_timeout\\n        │                                          ▼\\n        │                              ┌─────────────────────┐\\n        └──────────────────────────────│      HALF_OPEN      │\\n                                       │  (limited trial)    │\\n                                       └─────────────────────┘\\n                                                │\\n                                          trial call fails\\n                                                ▼\\n                                         back to OPEN\\n\\nTransition rules\\n================\\n* CLOSED  -> OPEN      : `failure_threshold` consecutive failures recorded.\\n* OPEN    -> HALF_OPEN : `recovery_timeout` seconds elapsed since opening.\\n* HALF_OPEN            : allows at most `half_open_max_calls` concurrent trial calls.\\n* HALF_OPEN -> CLOSED  : any trial call succeeds -> dependency recovered.\\n* HALF_OPEN -> OPEN    : any trial call fails   -> dependency still broken.\\n\\nThread-safety\\n=============\\nAll internal state mutations happen inside `self._lock` (asyncio.Lock),\\nso the breaker is safe to share across many concurrent coroutines.\\n\\nUsage\\n=====\\n    breaker = CircuitBreaker(failure_threshold=3, recovery_timeout=5.0)\\n    try:\\n        result = await breaker.call(my_async_fn, *args, **kwargs)\\n    except CircuitOpenError:\\n        # fail fast - do not touch the dependency\\n        result = fallback()\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport asyncio\\nimport logging\\nimport time\\nfrom enum import Enum\\nfrom typing import Any, Awaitable, Callable, Optional, TypeVar\\n\\nlogger = logging.getLogger(__name__)\\n\\nT = TypeVar(\\\"T\\\")\\n\\n\\nclass CircuitState(Enum):\\n    \\\"\\\"\\\"The three states of a circuit breaker.\\\"\\\"\\\"\\n\\n    CLOSED = \\\"closed\\\"\\n    OPEN = \\\"open\\\"\\n    HALF_OPEN = \\\"half_open\\\"\\n\\n    def __str__(self) -> str:  # pragma: no cover - trivial\\n        return self.value\\n\\n\\nclass CircuitOpenError(Exception):\\n    \\\"\\\"\\\"Raised when a call is rejected because the circuit is OPEN (fail-fast).\\\"\\\"\\\"\\n\\n    def __init__(self, message: str = \\\"Circuit is open; call rejected (fail-fast).\\\") -> None:\\n        super().__init__(message)\\n\\n\\nclass CircuitBreaker:\\n    \\\"\\\"\\\"An asyncio-aware circuit breaker guarding calls to a fragile dependency.\\n\\n    Parameters\\n    ----------\\n    name:\\n        Human-readable identifier used in logs / errors.\\n    failure_threshold:\\n        Consecutive failures inside CLOSED state that trip the breaker to OPEN.\\n    recovery_timeout:\\n        Seconds the breaker stays OPEN before allowing a trial (HALF_OPEN).\\n    half_open_max_calls:\\n        Maximum number of concurrent trial calls allowed while HALF_OPEN.\\n    exceptions:\\n        Tuple of exception types counted as \\\"failures\\\". Anything else is\\n        re-raised without affecting the breaker state.\\n    \\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        name: str = \\\"default\\\",\\n        failure_threshold: int = 5,\\n        recovery_timeout: float = 30.0,\\n        half_open_max_calls: int = 1,\\n        exceptions: tuple[type[BaseException], ...] = (Exception,),\\n    ) -> None:\\n        if failure_threshold <= 0:\\n            raise ValueError(\\\"failure_threshold must be > 0\\\")\\n        if recovery_timeout <= 0:\\n            raise ValueError(\\\"recovery_timeout must be > 0\\\")\\n        if half_open_max_calls <= 0:\\n            raise ValueError(\\\"half_open_max_calls must be > 0\\\")\\n\\n        self.name = name\\n        self.failure_threshold = failure_threshold\\n        self.recovery_timeout = recovery_timeout\\n        self.half_open_max_calls = half_open_max_calls\\n        self.exceptions = exceptions\\n\\n        # --- internal state (always guarded by self._lock) ---\\n        self._state = CircuitState.CLOSED\\n        self._failure_count = 0\\n        self._half_open_used = 0\\n        self._opened_at: Optional[float] = None\\n        self._lock = asyncio.Lock()\\n        self._on_state_change: Optional[Callable[[CircuitState, CircuitState], Any]] = None\\n\\n        # --- observability counters (approximate, not atomic under lock) ---\\n        self.total_calls = 0\\n        self.successful_calls = 0\\n        self.failed_calls = 0\\n        self.rejected_calls = 0\\n\\n    # ------------------------------------------------------------------ #\\n    # Public API\\n    # ------------------------------------------------------------------ #\\n    @property\\n    def state(self) -> CircuitState:\\n        \\\"\\\"\\\"Current state of the breaker (CLOSED / OPEN / HALF_OPEN).\\\"\\\"\\\"\\n        return self._state\\n\\n    @property\\n    def failure_count(self) -> int:\\n        return self._failure_count\\n\\n    @property\\n    def is_open(self) -> bool:\\n        return self._state is CircuitState.OPEN\\n\\n    def on_state_change(\\n        self, callback: Callable[[CircuitState, CircuitState], Any]\\n    ) -> None:\\n        \\\"\\\"\\\"Register a callback invoked as ``callback(old_state, new_state)``.\\n\\n        Useful for metrics (Prometheus), logging, or alerts. The callback must\\n        never raise: exceptions are caught and logged.\\n        \\\"\\\"\\\"\\n        self._on_state_change = callback\\n\\n    def stats(self) -> dict:\\n        \\\"\\\"\\\"Return a snapshot of the internal counters.\\\"\\\"\\\"\\n        return {\\n            \\\"name\\\": self.name,\\n            \\\"state\\\": self._state.value,\\n            \\\"failure_count\\\": self._failure_count,\\n            \\\"total_calls\\\": self.total_calls,\\n            \\\"successful_calls\\\": self.successful_calls,\\n            \\\"failed_calls\\\": self.failed_calls,\\n            \\\"rejected_calls\\\": self.rejected_calls,\\n        }\\n\\n    async def call(self, func: Callable[..., Awaitable[T]], *args: Any, **kwargs: Any) -> T:\\n        \\\"\\\"\\\"Execute ``func(*args, **kwargs)`` through the circuit breaker.\\n\\n        Raises\\n        ------\\n        CircuitOpenError\\n            If the breaker is OPEN (or HALF_OPEN with no trial slots left),\\n            the call is rejected without touching the dependency.\\n        func's exceptions\\n            Re-raised after the failure has been recorded by the breaker.\\n        \\\"\\\"\\\"\\n        if not await self._try_acquire_permission():\\n            self.rejected_calls += 1\\n            raise CircuitOpenError(\\n                f\\\"[{self.name}] breaker is {self._state.value}; call rejected (fail-fast).\\\"\\n            )\\n\\n        self.total_calls += 1\\n        try:\\n            result = await func(*args, **kwargs)\\n        except self.exceptions as exc:\\n            self.failed_calls += 1\\n            await self._record_failure()\\n            raise\\n        else:\\n            self.successful_calls += 1\\n            await self._record_success()\\n            return result\\n\\n    # ------------------------------------------------------------------ #\\n    # Internals — all mutating methods run under self._lock\\n    # ------------------------------------------------------------------ #\\n    async def _try_acquire_permission(self) -> bool:\\n        \\\"\\\"\\\"Atomically decide whether a new call may enter the dependency.\\\"\\\"\\\"\\n        async with self._lock:\\n            if self._state is CircuitState.CLOSED:\\n                return True\\n\\n            if self._state is CircuitState.OPEN:\\n                elapsed = time.monotonic() - (self._opened_at or 0.0)\\n                if elapsed >= self.recovery_timeout:\\n                    # Cooldown finished -> allow a limited number of trials.\\n                    self._transition(CircuitState.HALF_OPEN)\\n                    self._half_open_used = 0\\n                else:\\n                    return False\\n\\n            # HALF_OPEN: only `half_open_max_calls` trial calls may run.\\n            if self._half_open_used >= self.half_open_max_calls:\\n                return False\\n            self._half_open_used += 1\\n            return True\\n\\n    async def _record_success(self) -> None:\\n        async with self._lock:\\n            if self._state is CircuitState.HALF_OPEN:\\n                # A trial call succeeded -> the dependency has recovered.\\n                self._transition(CircuitState.CLOSED)\\n                self._half_open_used = 0\\n            # Reset the consecutive-failure counter on any success (CLOSED too).\\n            self._failure_count = 0\\n\\n    async def _record_failure(self) -> None:\\n        async with self._lock:\\n            self._failure_count += 1\\n            if self._state is CircuitState.HALF_OPEN:\\n                # A trial call failed -> still broken, trip it again.\\n                self._open_circuit()\\n            elif self._failure_count >= self.failure_threshold:\\n                self._open_circuit()\\n\\n    def _open_circuit(self) -> None:\\n        self._transition(CircuitState.OPEN)\\n        self._opened_at = time.monotonic()\\n\\n    def _transition(self, new_state: CircuitState) -> None:\\n        old = self._state\\n        if old is new_state:\\n            return\\n        self._state = new_state\\n        logger.info(\\\"Circuit [%s]: %s -> %s\\\", self.name, old.value, new_state.value)\\n        if self._on_state_change is not None:\\n            try:\\n                self._on_state_change(old, new_state)\\n            except Exception:  # pragma: no cover - defensive\\n                logger.exception(\\\"state-change callback failed\\\")\\n\\n\\ndef circuit(*cb_args: Any, **cb_kwargs: Any):\\n    \\\"\\\"\\\"Decorator that wraps an async function with a CircuitBreaker.\\n\\n    Example\\n    -------\\n        @circuit(name=\\\"db\\\", failure_threshold=3, recovery_timeout=5.0)\\n        async def query(sql: str) -> list[dict]:\\n            ...\\n\\n        await query(\\\"SELECT 1\\\")            # normal call\\n        await query(\\\"SELECT 1\\\")            # raises CircuitOpenError if OPEN\\n        query.circuit_breaker.state        # inspect the breaker from outside\\n    \\\"\\\"\\\"\\n\\n    breaker = CircuitBreaker(*cb_args, **cb_kwargs)\\n\\n    def decorator(func: Callable[..., Awaitable[T]]) -> Callable[..., Awaitable[T]]:\\n        async def wrapper(*args: Any, **kwargs: Any) -> T:\\n            return await breaker.call(func, *args, **kwargs)\\n\\n        wrapper.circuit_breaker = breaker  # type: ignore[attr-defined]\\n        wrapper.__name__ = func.__name__\\n        wrapper.__doc__ = func.__doc__\\n        return wrapper\\n\\n    return decorator\\n\",\"file_path\":\"/home/daytona/asyncio_circuit_breaker/circuit_breaker/circuit_breaker.py\",\"__result\":\"Updated file /home/daytona/asyncio_circuit_breaker/circuit_breaker/circuit_breaker.py\"},\"result\":\"Updated file /home/daytona/asyncio_circuit_breaker/circuit_breaker/circuit_breaker.py\",\"hasResult\":true},\"startedAt\":\"2026-08-25T02:45:24.000Z\",\"stepId\":\"step-0\",\"endedAt\":\"2026-08-25T02:45:26.000Z\"},{\"type\":\"tool_call_result\",\"content\":{\"tool_call_id\":\"ca