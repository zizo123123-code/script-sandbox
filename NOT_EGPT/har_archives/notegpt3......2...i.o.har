": \"ه\", \"time\": \"2026-08-25 02:48:24 UTC\"}\n\ndata: {\"type\": \"text\", \"text\": \"ما\", \"time\": \"2026-08-25 02:48:24 UTC\"}\n\ndata: {\"type\": \"text\", \"text\": \":\", \"time\": \"2026-08-25 02:48:24 UTC\"}\n\ndata: {\"type\": \"credit_usage\", \"data\": {\"credits\": 9}, \"time\": \"2026-08-25 02:48:29 UTC\"}\n\ndata: {\"type\": \"tool_call\", \"data\": {\"name\": \"edit_file\", \"args\": {\"file_path\": \"/home/daytona/asyncio_circuit_breaker/tests/test_retry.py\", \"new_string\": \"def test_non_retryable_exception_propagates_immediately() -> None:\\n    async def boom():\\n        raise ValueError(\\\"fatal, no retry\\\")\\n\\n    # ValueError ليس من ضمن أنواع الأخطاء القابلة لإعادة المحاولة -> ينتشر فوراً\\n    policy = RetryPolicy(max_attempts=5, base_delay=0, retry_on=(ConnectionError,))\\n    with pytest.raises(ValueError):\\n        run(lambda: retry(boom, policy=policy))\", \"old_string\": \"def test_non_retryable_exception_propagates_immediately() -> None:\\n    async def boom():\\n        raise ValueError(\\\"fatal, no retry\\\")\\n\\n    with pytest.raises(ValueError):\\n        run(lambda: retry(boom, policy=RetryPolicy(max_attempts=5, base_delay=0)))\"}, \"id\": \"call_00_gIYCDisSZbSvEbHrejqJ6689\", \"type\": \"tool_call\"}, \"time\": \"2026-08-25 02:48:29 UTC\"}\n\ndata: {\"type\": \"tool_call\", \"data\": {\"name\": \"edit_file\", \"args\": {\"file_path\": \"/home/daytona/asyncio_circuit_breaker/tests/test_circuit_breaker.py\", \"new_string\": \"def test_half_open_limits_concurrent_trials() -> None:\\n    breaker = CircuitBreaker(\\n        failure_threshold=1, recovery_timeout=0.05, half_open_max_calls=1\\n    )\\n    dep = FakeDependency()\\n    dep.set_mode(\\\"fail\\\")\\n\\n    with pytest.raises(ConnectionError):\\n        run(lambda: breaker.call(dep.call))\\n    assert breaker.state is CircuitState.OPEN\\n\\n    time.sleep(0.1)\\n\\n    inside = asyncio.Event()\\n\\n    async def first_slow() -> str:\\n        \\\"\\\"\\\"أول محاولة تجريبية: تدخل الدائرة وتحجز فتحة HALF_OPEN ثم تنجح بعد توقف.\\\"\\\"\\\"\\n        inside.set()\\n        await asyncio.sleep(0.2)\\n        return \\\"ok\\\"\\n\\n    async def scenario():\\n        t1 = asyncio.create_task(breaker.call(first_slow))\\n        # ننتظر حتى يدخل t1 فعلياً إلى الدائرة ويحجز فتحة المحاولة التجريبية\\n        await inside.wait()\\n        # الثاني يجب أن يُرفض فوراً لأن كل فتحات HALF_OPEN محجوزة\\n        with pytest.raises(CircuitOpenError):\\n            await breaker.call(dep.call)\\n        return await t1\\n\\n    result = run(scenario)\\n    assert result == \\\"ok\\\"\\n    # نجاح المحاولة التجريبية أغلق الدائرة، والخادم لم يُلمس سوى مرة واحدة\\n    assert breaker.state is CircuitState.CLOSED\\n    assert dep.calls == 0\", \"old_string\": \"def test_half_open_limits_concurrent_trials() -> None:\\n    breaker = CircuitBreaker(\\n        failure_threshold=1, recovery_timeout=0.05, half_open_max_calls=1\\n    )\\n    dep = FakeDependency()\\n    dep.set_mode(\\\"fail\\\")\\n\\n    with pytest.raises(ConnectionError):\\n        run(lambda: breaker.call(dep.call))\\n    assert breaker.state is CircuitState.OPEN\\n\\n    time.sleep(0.1)\\n\\n    async def two_concurrent_calls() -> list:\\n        dep.set_mode(\\\"ok\\\")  # سننجح، لكن يجب ألا يتجاوز تيار واحد فقط\\n\\n        started = asyncio.Event()\\n\\n        async def slow_call():\\n            started.set()\\n            await asyncio.sleep(0.2)\\n            return await breaker.call(dep.call)\\n\\n        # الأول يدخل HALF_OPEN ويحجز الفتحة، الثاني يجب أن يُرفض\\n        t1 = asyncio.create_task(slow_call())\\n        await started.wait()\\n        with pytest.raises(CircuitOpenError):\\n            await breaker.call(dep.call)\\n        await t1\\n        return [breaker.state, dep.calls]\\n\\n    state, calls = run(two_concurrent_calls)\\n    assert state is CircuitState.CLOSED\\n    assert calls == 1  # لم يدخل سوى تيار واحد فعلياً\"}, \"id\": \"call_01_3D6Ny2CUxPiMSOi