            "text": "{\"code\": 100000, \"message\": \"success\", \"data\": [{\"id\": \"1d5a566a-aea8-49f8-9e7a-1d24a5b22643\", \"question\": \"2. \\u0635\\u0645\\u0645 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0643\\u0648\\u062f \\u0628\\u0627\\u064a\\u062b\\u0648\\u0646 \\u0645\\u062a\\u0643\\u0627\\u0645\\u0644 \\u0628\\u0646\\u0638\\u0627\\u0645 Asyncio \\u0644\\u062a\\u0637\\u0628\\u064a\\u0642 \\u0645\\u0639\\u0645\\u0627\\u0631\\u064a\\u0629 Circuit Breaker Pattern \\u0645\\u0639 Retry \\u0648 Expon\", \"type\": \"text\", \"status\": \"processing\", \"source\": \"agent\", \"created_at\": 1787625835, \"updated_at\": 1787626145}, {\"id\": \"c2364143-644d-4edc-953a-5de04e226151\", \"question\": \"3. \\u0635\\u0645\\u0645 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0643\\u0648\\u062f \\u0628\\u0627\\u064a\\u062b\\u0648\\u0646 \\u0645\\u062a\\u0643\\u0627\\u0645\\u0644 \\u0628\\u0646\\u0638\\u0627\\u0645 Asyncio \\u0644\\u062a\\u0637\\u0628\\u064a\\u0642 \\u0645\\u0639\\u0645\\u0627\\u0631\\u064a\\u0629 Circuit Breaker Pattern \\u0645\\u0639 Retry \\u0648 Expon\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787625865, \"updated_at\": 1787625976}, {\"id\": \"876f63f4-4bef-4399-9edc-ab3e51c94bc5\", \"question\": \"1. \\u0635\\u0645\\u0645 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0643\\u0648\\u062f \\u0628\\u0627\\u064a\\u062b\\u0648\\u0646 \\u0645\\u062a\\u0643\\u0627\\u0645\\u0644 \\u0628\\u0646\\u0638\\u0627\\u0645 Asyncio \\u0644\\u062a\\u0637\\u0628\\u064a\\u0642 \\u0645\\u0639\\u0645\\u0627\\u0631\\u064a\\u0629 Circuit Breaker Pattern \\u0645\\u0639 Retry \\u0648 Expon\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787625808, \"updated_at\": 1787625966}, {\"id\": \"5fb77d6c-b749-4b2f-b73e-cd1aed86781a\", \"question\": \"\\u0635\\u0645\\u0645 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0643\\u0648\\u062f \\u0628\\u0627\\u064a\\u062b\\u0648\\u0646 \\u0645\\u062a\\u0643\\u0627\\u0645\\u0644 \\u0628\\u0646\\u0638\\u0627\\u0645 Asyncio \\u0644\\u062a\\u0637\\u0628\\u064a\\u0642 \\u0645\\u0639\\u0645\\u0627\\u0631\\u064a\\u0629 Circuit Breaker Pattern \\u0645\\u0639 Retry \\u0648 Exponent\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787610528, \"updated_at\": 1787610618}, {\"id\": \"64629a16-a485-46ac-af42-8ebf05950b10\", \"question\": \"\\u0635\\u0645\\u0645 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0643\\u0648\\u062f \\u0628\\u0627\\u064a\\u062b\\u0648\\u0646 \\u0645\\u062a\\u0643\\u0627\\u0645\\u0644 \\u0628\\u0646\\u0638\\u0627\\u0645 Asyncio \\u0644\\u062a\\u0637\\u0628\\u064a\\u0642 \\u0645\\u0639\\u0645\\u0627\\u0631\\u064a\\u0629 Circuit Breaker Pattern \\u0645\\u0639 Retry \\u0648 Exponent\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787609044, \"updated_at\": 1787609512}, {\"id\": \"5b9edc2a-4bb5-40ff-abcb-7dfb04111fa3\", \"question\": \"\\u0635\\u0645\\u0645 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0643\\u0648\\u062f \\u0628\\u0627\\u064a\\u062b\\u0648\\u0646 \\u0645\\u062a\\u0643\\u0627\\u0645\\u0644 \\u0628\\u0646\\u0638\\u0627\\u0645 Asyncio \\u0644\\u062a\\u0637\\u0628\\u064a\\u0642 \\u0645\\u0639\\u0645\\u0627\\u0631\\u064a\\u0629 Circuit Breaker Pattern \\u0645\\u0639 Retry \\u0648 Exponent\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787609045, \"updated_at\": 1787609136}, {\"id\": \"c1ff3bd4-e001-48b5-9d8c-957c04dd81fc\", \"question\": \"\\u062a\\u062c\\u0631\\u0628\\u0629 \\u0632\\u064a\\u0632\\u0648 \\u0644\\u062d\\u0641\\u0638 \\u0627\\u0644\\u0631\\u062f \\u0641\\u064a \\u0627\\u0644\\u0633\\u062c\\u0644 \\u0644\\u0627\\u064a\\u0641 \\ud83d\\ude80\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787608809, \"updated_at\": 1787608809}, {\"id\": \"2d3b5d40-7224-494c-a805-559797ccee25\", \"question\": \"2222222+444444\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787608430, \"updated_at\": 1787608434}, {\"id\": \"ffff672b-2de2-418b-9bbd-da4d0836c52d\", \"question\": \"\\u0645\\u0646 \\u0623\\u0646\\u062a\\u061f \\u0648\\u0645\\u0627 \\u0647\\u064a \\u0642\\u062f\\u0631\\u0627\\u062a\\u0643 \\u0643\\u0623\\u064a\\u062c\\u0646\\u062a \\u062f\\u0627\\u062e\\u0644 \\u0628\\u064a\\u0626\\u0629 \\u0627\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787606023, \"updated_at\": 1787608388}, {\"id\": \"ede6aea9-08d0-402c-8fa6-75391f80bb49\", \"question\": \"\\u0627\\u062d\\u0633\\u0628 \\u0645\\u0633\\u0627\\u062d\\u0629 \\u062f\\u0627\\u0626\\u0631\\u0629 \\u0646\\u0635\\u0641 \\u0642\\u0637\\u0631\\u0647\\u0627 5 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0627\\u0644\\u062e\\u0637\\u0648\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787604797, \"updated_at\": 1787604812}, {\"id\": \"ca666cce-6a12-4cd4-bfef-fd24eb1a641b\", \"question\": \"\\u0627\\u062d\\u0633\\u0628 7 * 8 \\u0648\\u0627\\u0643\\u062a\\u0628 \\u0627\\u0644\\u0646\\u062a\\u064a\\u062c\\u0629 \\u0628\\u0627\\u0644\\u0645\\u0635\\u0631\\u064a\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"agent\", \"created_at\": 1787572660, \"updated_at\": 1787572660}, {\"id\": \"a26b42f0-8a7a-4bd8-99e6-020e32899e44\", \"question\": \"\\u0627\\u062d\\u0633\\u0628 15 * 4 \\u0648\\u0627\\u0634\\u0631\\u062d \\u0627\\u0644\\u062e\\u0637\\u0648\\u0627\\u062a \\u0628\\u0627\\u0644\\u0645\\u0635\\u0631\\u064a\", \"type\": \"text\", \"status\": \"finish\", \"source\": \"ai_chat\", \"created_at\": 1787572629, \"updated_at\": 1787572629}, {\"id\": \"43b829a7-13ff-4638-921a-94040da66d9e\", \"question\": \"\\u062a\\u062c\\u0631\\u0628\\u0629 \\u062d\\u0641\\u0638 \\u0633\\u062c\\u0644 \\u0627\\u0644\\u0623\\u064a\\u062c\\u0646\\u062a \\u0641\\u064a \\u0627\\u0644\\u0642\\u0627\\u0626\\u0645\\u0629 \\u0628\\u0627\\u0644\\u0645\\u0635\\u0631\\u064a \\ud83d\\ude80\", \"type\": \"text\", \"statu